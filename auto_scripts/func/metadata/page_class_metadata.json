{
  "pages": {
    "ShoppingCartPage": {
      "file_name": "shopping_cart_page.py",
      "locators": {
        "add_product_a_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='A']"},
        "add_product_b_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='B']"},
        "cart_icon": {"by": "PLACEHOLDER", "value": "//a[@id='cart']"},
        "product_a_row": {"by": "PLACEHOLDER", "value": "//tr[@data-product='A']"},
        "product_b_row": {"by": "PLACEHOLDER", "value": "//tr[@data-product='B']"},
        "product_a_quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='qty_A']"},
        "product_a_subtotal": {"by": "PLACEHOLDER", "value": "//span[@id='subtotal_A']"},
        "product_b_quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='qty_B']"},
        "product_b_subtotal": {"by": "PLACEHOLDER", "value": "//span[@id='subtotal_B']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart_total']"}
      },
      "actions": [
        "add_product_a(qty)",
        "add_product_b(qty)",
        "go_to_cart()",
        "change_product_a_quantity(qty)",
        "change_product_b_quantity(qty)"
      ],
      "validations": [
        "is_cart_page_displayed()",
        "verify_product_a_details(expected_details)",
        "verify_product_b_details(expected_details)",
        "verify_cart_total(expected_total)",
        "verify_no_page_refresh_or_spinner()"
      ]
    }
  }
}