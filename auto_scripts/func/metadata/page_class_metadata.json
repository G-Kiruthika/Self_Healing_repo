{
  "pages": {
    "ExperianHomepage": {
      "file_name": "experian_homepage.py",
      "locators": {
        "header_navigation": {"by": "XPATH", "value": "//header"},
        "loans_menu_button": {"by": "XPATH", "value": "//nav//a[contains(text(), 'Loans')]"},
        "insurance_menu_button": {"by": "XPATH", "value": "//nav//a[contains(text(), 'Insurance')]"}
      },
      "actions": [
        "navigate_to_homepage()",
        "locate_header_navigation()"
      ],
      "validations": [
        "is_loans_menu_visible()",
        "is_insurance_menu_visible()"
      ]
    }
  }
}