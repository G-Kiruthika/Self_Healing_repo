{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "add_to_cart_button": {"by": "XPATH", "value": "//button[contains(text(), 'Add to Cart')]"},
        "quantity_input": {"by": "XPATH", "value": "//input[@name='quantity']"},
        "cart_item": {"by": "XPATH", "value": "//div[contains(@class, 'cart-item') and contains(., 'Wireless Mouse')]"},
        "delete_button": {"by": "XPATH", "value": "//button[contains(text(), 'Delete')]"},
        "cart_total": {"by": "XPATH", "value": "//div[@id='cart-total']"},
        "line_item_subtotal": {"by": "XPATH", "value": "//span[@class='line-item-subtotal']"}
      },
      "actions": [
        "add_to_cart(product_name, quantity)",
        "set_quantity(product_name, quantity)",
        "delete_item(product_name)",
        "view_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name, quantity)",
        "is_cart_total_updated()",
        "is_line_item_subtotal_updated(product_name)"
      ]
    }
  }
}