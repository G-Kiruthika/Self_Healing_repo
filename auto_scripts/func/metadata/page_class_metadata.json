{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "add_to_cart_button": {"by": "ID", "value": "add-to-cart-btn"},
        "product_quantity_input": {"by": "ID", "value": "product-quantity-input"},
        "remove_product_button": {"by": "ID", "value": "remove-product-btn"},
        "cart_contents_area": {"by": "ID", "value": "cart-contents"},
        "cart_update_button": {"by": "ID", "value": "cart-update-btn"}
      },
      "actions": [
        "add_product_to_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "remove_product_from_cart(product_name)",
        "submit_cart_update()"
      ],
      "validations": [
        "verify_product_in_cart(product_name)",
        "verify_cart_updated_without_refresh()",
        "verify_no_product_with_negative_quantity()"
      ]
    }
  }
}