{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username"},
        "password_input": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "loginBtn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_a_item": {"by": "XPATH", "value": "//div[text()='Wireless Mouse']"},
        "product_b_item": {"by": "XPATH", "value": "//div[text()='Coffee Subscription']"},
        "add_to_cart_a_button": {"by": "XPATH", "value": "//div[text()='Wireless Mouse']/../button[text()='Add to Cart']"},
        "add_to_cart_b_button": {"by": "XPATH", "value": "//div[text()='Coffee Subscription']/../button[text()='Add to Cart']"},
        "min_threshold_info_b": {"by": "XPATH", "value": "//div[text()='Coffee Subscription']//span[contains(@class,'min-threshold')]"}
      },
      "actions": [
        "locate_product(product_name)",
        "add_to_cart(product_name)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_min_threshold_displayed(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_icon": {"by": "ID", "value": "cartIcon"},
        "cart_item_count": {"by": "XPATH", "value": "//span[@id='cartCount']"},
        "subtotal_a": {"by": "XPATH", "value": "//tr[td[contains(text(),'Wireless Mouse')]]/td[@class='subtotal']"},
        "subtotal_b": {"by": "XPATH", "value": "//tr[td[contains(text(),'Coffee Subscription')]]/td[@class='subtotal']"}
      },
      "actions": [
        "open_cart()"
      ],
      "validations": [
        "is_cart_count(count)",
        "verify_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
} 