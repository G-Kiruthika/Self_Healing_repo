{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "product-row"},
        "delete_button": {"by": "PLACEHOLDER", "value": "delete-btn"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "empty-cart-msg"},
        "continue_shopping_button": {"by": "PLACEHOLDER", "value": "continue-shopping-btn"},
        "checkout_button": {"by": "PLACEHOLDER", "value": "checkout-btn"},
        "quantity_field": {"by": "PLACEHOLDER", "value": "quantity-field"},
        "inventory_error": {"by": "PLACEHOLDER", "value": "inventory-error"},
        "suggestion_message": {"by": "PLACEHOLDER", "value": "suggestion-msg"}
      },
      "actions": [
        "click_delete_button(product_id)",
        "click_continue_shopping()",
        "update_quantity(product_id, quantity)"
      ],
      "validations": [
        "verify_cart_contains(product_id, quantity)",
        "verify_empty_cart_message_displayed()",
        "verify_navigation_to_catalog()",
        "verify_checkout_button_absent()",
        "verify_inventory_error_displayed()",
        "verify_quantity(product_id, expected_quantity)",
        "verify_suggestion_message_displayed(max_available)"
      ]
    },
    "CatalogPage": {
      "file_name": "catalog_page.py",
      "locators": {
        "product_list": {"by": "PLACEHOLDER", "value": "product-list"}
      },
      "actions": [
        "navigate_to_catalog()"
      ],
      "validations": [
        "verify_catalog_displayed()"
      ]
    }
  }
}