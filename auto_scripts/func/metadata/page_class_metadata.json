{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Laptop Stand')]]"},
        "product_b_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Coffee Subscription')]]"},
        "quantity_input": {"by": "xpath", "value": "//input[@name='quantity']"},
        "line_item_subtotal": {"by": "xpath", "value": "//td[@class='subtotal']"},
        "inventory_error": {"by": "xpath", "value": "//div[contains(@class,'error') and contains(text(),'inventory')]"},
        "warning_message": {"by": "xpath", "value": "//div[contains(@class,'warning')]"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity, available_stock)",
        "update_quantity(product_name, quantity)",
        "attempt_reduce_quantity(product_name, target_quantity)",
        "check_line_item_subtotal(product_name)",
        "check_error_messages(product_name)"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_quantity_updated(product_name, expected_quantity)",
        "validate_subtotal(product_name, expected_subtotal)",
        "validate_no_inventory_error()",
        "validate_warning_message_displayed()",
        "validate_quantity_at_minimum(product_name, min_quantity)"
      ]
    }
  }
}