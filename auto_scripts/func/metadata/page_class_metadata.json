{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item": {"by": "PLACEHOLDER", "value": "cart_item_locator"},
        "quantity_field": {"by": "PLACEHOLDER", "value": "quantity_field_locator"},
        "increment_button": {"by": "PLACEHOLDER", "value": "increment_button_locator"},
        "max_quantity_message": {"by": "PLACEHOLDER", "value": "max_quantity_message_locator"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "line_item_subtotal_locator"},
        "confirmation_message": {"by": "PLACEHOLDER", "value": "confirmation_message_locator"}
      },
      "actions": [
        "set_cart_item_quantity(product_code, quantity)",
        "increment_quantity(product_code)",
        "navigate_to_cart()"
      ],
      "validations": [
        "verify_cart_item_quantity(product_code, expected_quantity)",
        "verify_increment_button_disabled(product_code)",
        "verify_max_quantity_message_displayed(product_code)",
        "verify_line_item_subtotal(product_code, expected_subtotal)",
        "verify_confirmation_message(expected_message)"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "add_to_cart_button": {"by": "PLACEHOLDER", "value": "add_to_cart_button_locator"}
      },
      "actions": [
        "click_add_to_cart(product_code)"
      ],
      "validations": []
    }
  }
}