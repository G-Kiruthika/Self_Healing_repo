{
  "pages": {
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "product_a_add_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='A']"},
        "product_b_add_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='B']"},
        "cart_icon": {"by": "PLACEHOLDER", "value": "//a[@href='/cart']"}
      },
      "actions": [
        "add_product_to_cart(product_name, quantity)",
        "navigate_to_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_on_product_page()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_product_row": {"by": "PLACEHOLDER", "value": "//tr[@data-product='{product_name}']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@data-product='{product_name}']"},
        "subtotal_cell": {"by": "PLACEHOLDER", "value": "//td[@data-subtotal-for='{product_name}']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart_total']"}
      },
      "actions": [
        "change_product_quantity(product_name, quantity)",
        "observe_cart_total()"
      ],
      "validations": [
        "verify_product_details(product_name, unit_price, quantity, subtotal)",
        "verify_cart_total(total)",
        "is_on_cart_page()",
        "no_page_refresh_or_spinner()"
      ]
    }
  }
}