{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_name": {"by": "XPATH", "value": "//td[@class='product-name']"},
        "unit_price": {"by": "XPATH", "value": "//td[@class='unit-price']"},
        "quantity_field": {"by": "XPATH", "value": "//input[@class='quantity-input']"},
        "subtotal": {"by": "XPATH", "value": "//td[@class='subtotal']"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "success_message": {"by": "XPATH", "value": "//div[contains(@class, 'success-message')]"},
        "update_button": {"by": "XPATH", "value": "//button[@id='update-cart']"}
      },
      "actions": [
        "navigate_to_cart()",
        "enter_quantity(product, quantity)",
        "click_update_cart()"
      ],
      "validations": [
        "verify_products_in_cart(product_list)",
        "verify_product_details(product)",
        "verify_cart_total(expected_total)",
        "verify_success_message(expected_message)"
      ]
    }
  }
}