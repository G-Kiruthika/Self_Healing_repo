{
  "pages": {
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "out_of_stock_indicator": {"by": "xpath", "value": "//span[@class='stock-status']"},
        "add_to_cart_button": {"by": "id", "value": "add-to-cart-btn"},
        "error_message": {"by": "css selector", "value": ".error-message"}
      },
      "actions": [
        "view_product(product_id)",
        "click_add_to_cart()"
      ],
      "validations": [
        "is_out_of_stock_displayed()",
        "is_add_to_cart_disabled()",
        "is_error_message_displayed()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item": {"by": "xpath", "value": "//div[@class='cart-item'][@data-product-id='{product_id}']"},
        "decrement_button": {"by": "css selector", "value": ".decrement-btn"},
        "quantity_field": {"by": "css selector", "value": ".quantity-input"},
        "validation_error": {"by": "css selector", "value": ".validation-error"}
      },
      "actions": [
        "view_cart()",
        "click_decrement(product_id)"
      ],
      "validations": [
        "is_cart_item_present(product_id)",
        "is_quantity_displayed(product_id, quantity)",
        "is_decrement_disabled(product_id)",
        "is_validation_error_displayed()"
      ]
    }
  }
}