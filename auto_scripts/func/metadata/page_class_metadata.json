{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "wireless_mouse_add_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='Wireless Mouse']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[@class='delete']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[@class='line-subtotal']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"}
      },
      "actions": [
        "add_wireless_mouse_to_cart(quantity)",
        "change_quantity(quantity)",
        "delete_wireless_mouse_from_cart()"
      ],
      "validations": [
        "validate_product_in_cart(product, quantity)",
        "validate_quantity_updated(quantity)",
        "validate_line_item_subtotal_updates()",
        "validate_cart_total_updates()",
        "validate_product_removed(product)",
        "validate_cart_totals_recalculated()"
      ]
    }
  }
}