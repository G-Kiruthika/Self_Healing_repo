{
  "pages": {
    "ShoppingCartPage": {
      "file_name": "shopping_cart_page.py",
      "locators": {
        "product_a_row": {"by": "xpath", "value": "//tr[@data-product='A']"},
        "product_b_row": {"by": "xpath", "value": "//tr[@data-product='B']"},
        "add_product_button": {"by": "id", "value": "add-product-btn"},
        "quantity_field": {"by": "name", "value": "quantity"},
        "cart_total": {"by": "id", "value": "cart-total"},
        "line_item_subtotal": {"by": "class_name", "value": "line-item-subtotal"}
      },
      "actions": [
        "add_product(product_name, quantity)",
        "navigate_to_cart()",
        "change_quantity(product_name, quantity)"
      ],
      "validations": [
        "verify_product_in_cart(product_name, quantity, subtotal)",
        "verify_cart_total(expected_total)",
        "verify_no_page_refresh()"
      ]
    }
  }
}