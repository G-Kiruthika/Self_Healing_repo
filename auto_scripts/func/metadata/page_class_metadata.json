{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "XPATH", "value": "//tr[td[contains(text(), 'Wireless Mouse')]]"},
        "quantity_input": {"by": "XPATH", "value": "//tr[td[contains(text(), 'Wireless Mouse')]]//input[@type='number']"},
        "remove_button": {"by": "XPATH", "value": "//tr[td[contains(text(), 'Wireless Mouse')]]//button[contains(@class, 'remove')]"},
        "cart_totals": {"by": "ID", "value": "cart_totals"},
        "empty_cart_message": {"by": "ID", "value": "empty_cart_message"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)",
        "remove_product(product_name)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_totals_updated()",
        "is_empty_cart_message_displayed()"
      ]
    }
  }
}