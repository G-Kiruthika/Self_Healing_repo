{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_item": {"by": "PLACEHOLDER", "value": "//div[@class='product-item' and .='Wireless Mouse']"},
        "add_to_cart_button": {"by": "PLACEHOLDER", "value": "//button[contains(@class, 'add-to-cart')]"},
        "cart_quantity_input": {"by": "PLACEHOLDER", "value": "//input[@class='cart-qty']"},
        "remove_product_button": {"by": "PLACEHOLDER", "value": "//button[contains(@class, 'remove-product')]"},
        "cart_icon": {"by": "PLACEHOLDER", "value": "//div[@id='cart-icon']"},
        "cart_ui": {"by": "PLACEHOLDER", "value": "//div[@id='cart-ui']"}
      },
      "actions": [
        "add_product_to_cart(product_name)",
        "update_product_quantity(product_name, quantity)",
        "remove_product_from_cart(product_name)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_updated_without_refresh()"
      ]
    }
  }
}