{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "PLACEHOLDER", "value": "//tr[td[text()='Product A']]"},
        "product_c_row": {"by": "PLACEHOLDER", "value": "//tr[td[text()='Product C']]"},
        "delete_button_product_c": {"by": "PLACEHOLDER", "value": "//tr[td[text()='Product C']]//button[text()='Delete']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "PLACEHOLDER", "value": "//button[text()='Return to Product Catalog']"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, subtotal)",
        "click_delete_button(product_name)",
        "navigate_to_cart_page()",
        "observe_cart_page()"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_product_not_present(product_name)",
        "validate_cart_total(expected_total)",
        "validate_cart_empty()",
        "validate_return_to_catalog_button_present()"
      ]
    }
  }
}