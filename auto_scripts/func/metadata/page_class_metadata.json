{
  "pages": {
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_list": {"by": "xpath", "value": "//div[@class='product-list']"},
        "wireless_mouse_add_to_cart_button": {"by": "xpath", "value": "//button[@data-product='Wireless Mouse']"},
        "cart_link": {"by": "id", "value": "cart-link"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name)",
        "view_cart()"
      ],
      "validations": [
        "is_catalog_displayed()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_items": {"by": "xpath", "value": "//div[@class='cart-item']"},
        "quantity_field": {"by": "xpath", "value": "//input[@name='quantity']"},
        "wireless_mouse_cart_item": {"by": "xpath", "value": "//div[@data-product='Wireless Mouse']"}
      },
      "actions": [
        "get_product_quantity(product_name)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_quantity_set(product_name, expected_quantity)"
      ]
    },
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_field": {"by": "id", "value": "username"},
        "password_field": {"by": "id", "value": "password"},
        "login_button": {"by": "id", "value": "login-btn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in_as(role)"
      ]
    }
  }
}