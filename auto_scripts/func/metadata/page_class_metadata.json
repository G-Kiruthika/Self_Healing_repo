{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Laptop Stand')]]"},
        "product_b_row": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Coffee Subscription')]]"},
        "quantity_input": {"by": "XPATH", "value": "//input[@name='quantity']"},
        "line_item_subtotal": {"by": "XPATH", "value": "//td[@class='subtotal']"},
        "inventory_error": {"by": "XPATH", "value": "//div[contains(@class,'error-message')]"},
        "warning_message": {"by": "XPATH", "value": "//div[contains(@class,'warning-message')]"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "get_line_item_subtotal(product_name)",
        "check_for_inventory_error()",
        "check_for_warning_message()"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_quantity(product_name, expected_quantity)",
        "validate_line_item_subtotal(product_name, expected_subtotal)",
        "validate_no_inventory_error()",
        "validate_warning_message(expected_message)"
      ]
    }
  }
}