{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_name": {"by": "XPATH", "value": "//div[@class='cart-item']//span[@class='product-name']"},
        "unit_price": {"by": "XPATH", "value": "//div[@class='cart-item']//span[@class='unit-price']"},
        "quantity_field": {"by": "XPATH", "value": "//input[@class='quantity-input']"},
        "subtotal": {"by": "XPATH", "value": "//span[@class='line-subtotal']"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "success_message": {"by": "XPATH", "value": "//div[@class='success-message']"},
        "update_button": {"by": "XPATH", "value": "//button[@id='update-cart']"}
      },
      "actions": [
        "navigate_to_cart_page()",
        "enter_quantity(product_name, quantity)",
        "click_update_button()"
      ],
      "validations": [
        "verify_product_in_cart(product_name)",
        "verify_unit_price(product_name, expected_price)",
        "verify_quantity(product_name, expected_quantity)",
        "verify_subtotal(product_name, expected_subtotal)",
        "verify_cart_total(expected_total)",
        "verify_success_message(expected_message)"
      ]
    }
  }
}