{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Wireless Mouse')]]"},
        "delete_button_product_a": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Wireless Mouse')]]//button[contains(text(),'Delete')]"},
        "cart_empty_message": {"by": "XPATH", "value": "//*[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "XPATH", "value": "//button[contains(text(),'Return to product catalog')]"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "product_b_row": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Product B')]]"},
        "product_c_row": {"by": "XPATH", "value": "//tr[.//td[contains(text(),'Product C')]]"},
        "line_item_subtotal": {"by": "XPATH", "value": "//td[@class='subtotal']"}
      },
      "actions": [
        "click_delete_button(product_name)",
        "navigate_to_cart_page()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_cart_total(expected_total)",
        "is_line_item_subtotal_correct(product_name, expected_subtotal)"
      ]
    }
  }
}