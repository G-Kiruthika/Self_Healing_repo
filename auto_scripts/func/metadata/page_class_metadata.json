{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "add_to_cart_button": {"by": "id", "value": "add-to-cart-btn"},
        "product_quantity_input": {"by": "id", "value": "product-qty-input"},
        "remove_product_button": {"by": "id", "value": "remove-product-btn"},
        "cart_contents": {"by": "id", "value": "cart-contents"}
      },
      "actions": [
        "add_product_to_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "remove_product_from_cart(product_name)",
        "submit_cart_update()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "cart_quantity_is(product_name, quantity)",
        "cart_has_no_negative_quantity()",
        "cart_updates_without_refresh()"
      ]
    }
  }
}