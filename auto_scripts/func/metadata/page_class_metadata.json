{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username_field"},
        "password_input": {"by": "ID", "value": "password_field"},
        "login_button": {"by": "ID", "value": "login_btn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in_as_subscriber()"
      ]
    },
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "product_item": {"by": "XPATH", "value": "//div[@class='product-item']"},
        "add_to_cart_button": {"by": "XPATH", "value": "//button[@class='add-to-cart']"},
        "quantity_input": {"by": "XPATH", "value": "//input[@class='quantity']"},
        "increase_quantity_button": {"by": "XPATH", "value": "//button[@class='increase-qty']"}
      },
      "actions": [
        "add_product_to_cart(product_name)",
        "increase_quantity(product_name, amount)"
      ],
      "validations": [
        "is_product_added_to_cart(product_name)",
        "is_quantity_updated(product_name, expected_quantity)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item": {"by": "XPATH", "value": "//div[@class='cart-item']"},
        "product_name": {"by": "XPATH", "value": ".//span[@class='product-name']"},
        "unit_price": {"by": "XPATH", "value": ".//span[@class='unit-price']"},
        "quantity": {"by": "XPATH", "value": ".//input[@class='item-qty']"},
        "subtotal": {"by": "XPATH", "value": ".//span[@class='subtotal']"},
        "view_cart_button": {"by": "ID", "value": "view_cart_btn"}
      },
      "actions": [
        "view_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_item_details_correct(product_name, unit_price, quantity, subtotal)"
      ]
    }
  }
}
