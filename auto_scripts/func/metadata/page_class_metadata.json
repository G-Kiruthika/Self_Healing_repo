{
  "pages": {
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "catalog_section": {"by": "id", "value": "catalog-section"},
        "wireless_mouse_add_to_cart_button": {"by": "xpath", "value": "//button[contains(text(),'Add to Cart') and ancestor::div[contains(.,'Wireless Mouse')]]"}
      },
      "actions": [
        "navigate_to_catalog()",
        "add_product_to_cart(product_name)",
        "view_cart()"
      ],
      "validations": [
        "is_catalog_displayed()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_wireless_mouse": {"by": "xpath", "value": "//div[contains(@class, 'cart-item') and contains(.,'Wireless Mouse')]"},
        "quantity_label": {"by": "xpath", "value": "//div[contains(@class, 'cart-item')]//span[@class='quantity']"}
      },
      "actions": [
        "view_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_quantity_set(product_name, quantity)"
      ]
    },
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "id", "value": "username"},
        "password_input": {"by": "id", "value": "password"},
        "login_button": {"by": "id", "value": "login-button"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in_as(user_type)"
      ]
    }
  }
}