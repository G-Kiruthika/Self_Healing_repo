{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_03": {"by": "PLACEHOLDER", "value": "//div[@data-product-id='TD-03']"},
        "cart_item_td_01": {"by": "PLACEHOLDER", "value": "//div[@data-product-id='TD-01']"},
        "quantity_field": {"by": "PLACEHOLDER", "value": "//input[@class='cart-quantity']"},
        "increment_button": {"by": "PLACEHOLDER", "value": "//button[@class='increment']"},
        "max_quantity_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Maximum available quantity reached')]"},
        "subtotal_label": {"by": "PLACEHOLDER", "value": "//span[@class='line-item-subtotal']"},
        "confirmation_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Quantity updated in cart')]"}
      },
      "actions": [
        "set_quantity(product_id, quantity)",
        "increment_quantity(product_id)",
        "navigate_to_cart()"
      ],
      "validations": [
        "verify_cart_item(product_id, quantity)",
        "verify_increment_disabled(product_id)",
        "verify_max_quantity_message()",
        "verify_subtotal(product_id, expected_subtotal)",
        "verify_confirmation_message()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "add_to_cart_button_td_01": {"by": "PLACEHOLDER", "value": "//button[@data-product-id='TD-01']"}
      },
      "actions": [
        "add_to_cart(product_id)",
        "navigate_to_product_catalog()"
      ],
      "validations": []
    }
  }
}