{
  "pages": {
    "ShoppingCartPage": {
      "file_name": "shopping_cart_page.py",
      "locators": {
        "product_row": {"by": "XPATH", "value": "//div[@class='cart-item-row']"},
        "product_name": {"by": "XPATH", "value": ".//span[@class='item-name']"},
        "unit_price": {"by": "XPATH", "value": ".//span[@class='unit-price']"},
        "quantity_field": {"by": "XPATH", "value": ".//input[@class='quantity-input']"},
        "subtotal": {"by": "XPATH", "value": ".//span[@class='subtotal']"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "success_message": {"by": "XPATH", "value": "//div[@class='message-success']"},
        "update_quantity_button": {"by": "XPATH", "value": ".//button[@class='update-qty']"}
      },
      "actions": [
        "navigate_to_cart_page()",
        "update_quantity(product_id, quantity)",
        "get_product_details(product_id)",
        "get_cart_total()"
      ],
      "validations": [
        "verify_product_in_cart(product_id, expected_qty)",
        "verify_product_fields(product_id)",
        "verify_cart_total(expected_total)",
        "verify_success_message(expected_message)"
      ]
    }
  }
}
