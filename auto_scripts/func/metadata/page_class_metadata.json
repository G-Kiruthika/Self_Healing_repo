{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_quantity_input": {"by": "id", "value": "product_quantity_input"},
        "add_to_cart_button": {"by": "id", "value": "add_to_cart_btn"},
        "cart_update_button": {"by": "id", "value": "cart_update_btn"},
        "cart_contents_section": {"by": "id", "value": "cart_contents"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)",
        "click_add_to_cart(product_name)",
        "submit_cart_update()"
      ],
      "validations": [
        "validate_no_zero_quantity_product()",
        "validate_no_negative_quantity_product()",
        "validate_quantity_unchanged(product_name, quantity)"
      ]
    }
  }
}