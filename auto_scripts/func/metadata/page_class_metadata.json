{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "xpath", "value": "//tr[@data-product-id]"},
        "quantity_field": {"by": "id", "value": "quantity_input"},
        "update_button": {"by": "id", "value": "update_button"},
        "validation_message": {"by": "css selector", "value": ".validation-error"},
        "cart_totals": {"by": "id", "value": "cart_totals"},
        "decrement_button": {"by": "css selector", "value": ".decrement-btn"},
        "increment_button": {"by": "css selector", "value": ".increment-btn"},
        "threshold_indicator": {"by": "css selector", "value": ".threshold-indicator"},
        "subtotal": {"by": "css selector", "value": ".line-subtotal"}
      },
      "actions": [
        "enter_quantity(product_id, quantity)",
        "click_update(product_id)",
        "get_cart_totals()",
        "get_quantity(product_id)",
        "is_decrement_disabled(product_id)",
        "is_increment_enabled(product_id)"
      ],
      "validations": [
        "validate_quantity(product_id, expected_quantity)",
        "validate_validation_message(expected_message)",
        "validate_cart_totals(expected_totals)",
        "validate_threshold_indicator(product_id, expected_threshold)",
        "validate_subtotal(product_id, expected_subtotal)"
      ]
    }
  }
}