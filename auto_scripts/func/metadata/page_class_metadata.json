{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_field": {"by": "ID", "value": "username"},
        "password_field": {"by": "ID", "value": "password"},
        "login_button": {"by": "XPATH", "value": "//button[@type='submit']"}
      },
      "actions": [
        "enter_username(username)",
        "enter_password(password)",
        "click_login()"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_a_card": {"by": "XPATH", "value": "//div[@data-product-name='Wireless Mouse']"},
        "product_b_card": {"by": "XPATH", "value": "//div[@data-product-name='Coffee Subscription']"},
        "add_to_cart_a_button": {"by": "XPATH", "value": "//div[@data-product-name='Wireless Mouse']//button[contains(text(),'Add to Cart')]"},
        "add_to_cart_b_button": {"by": "XPATH", "value": "//div[@data-product-name='Coffee Subscription']//button[contains(text(),'Add to Cart')]"}
      },
      "actions": [
        "add_product_to_cart(product_name)",
        "view_product(product_name)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_minimum_threshold_displayed(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_icon": {"by": "ID", "value": "cart-icon"},
        "cart_item_count": {"by": "XPATH", "value": "//span[@id='cart-count']"},
        "product_subtotal": {"by": "XPATH", "value": "//tr[@data-product]//td[@class='subtotal']"}
      },
      "actions": [
        "open_cart()",
        "get_cart_item_count()",
        "get_product_subtotal(product_name)"
      ],
      "validations": [
        "is_cart_item_count(count)",
        "is_product_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
} 