{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "XPATH", "value": "//tr[td[contains(text(),'Laptop Stand')]]"},
        "quantity_input": {"by": "XPATH", "value": "//input[@name='quantity']"},
        "update_button": {"by": "XPATH", "value": "//button[contains(text(),'Update')]"},
        "cart_total": {"by": "XPATH", "value": "//div[@id='cart-total']"},
        "inventory_error": {"by": "XPATH", "value": "//div[contains(@class,'error') and contains(text(),'inventory')]"}
      },
      "actions": [
        "set_quantity(product_name, quantity)",
        "click_update(product_name)"
      ],
      "validations": [
        "verify_product_in_cart(product_name, quantity)",
        "verify_inventory_error_displayed()",
        "verify_cart_total(expected_total)"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_e_row": {"by": "XPATH", "value": "//tr[td[contains(text(),'USB Cable')]]"},
        "stock_info": {"by": "XPATH", "value": "//td[contains(@class,'stock-info')]"},
        "add_to_cart_button": {"by": "XPATH", "value": "//button[contains(text(),'Add to Cart')]"},
        "inventory_error": {"by": "XPATH", "value": "//div[contains(@class,'error') and contains(text(),'inventory')]"}
      },
      "actions": [
        "add_product_to_cart(product_name)"
      ],
      "validations": [
        "verify_product_visible(product_name)",
        "verify_stock_info(product_name, expected_stock)",
        "verify_inventory_error_displayed()"
      ]
    },
    "HeaderPage": {
      "file_name": "header_page.py",
      "locators": {
        "cart_count": {"by": "XPATH", "value": "//span[@id='cart-count']"}
      },
      "actions": [],
      "validations": [
        "verify_cart_count(expected_count)"
      ]
    }
  }
}