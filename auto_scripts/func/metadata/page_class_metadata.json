{
  "pages": {
    "HomePage": {
      "file_name": "home_page.py",
      "locators": {
        "loan_payment_guides_link": {"by": "PLACEHOLDER", "value": "//a[text()='Loan Payment Guides']"}
      },
      "actions": [
        "click_loan_payment_guides_link()"
      ],
      "validations": [
        "is_homepage_displayed()"
      ]
    },
    "LoanPaymentGuidesPage": {
      "file_name": "loan_payment_guides_page.py",
      "locators": {
        "ud_loans_link": {"by": "PLACEHOLDER", "value": "//a[text()='UD Loans']"}
      },
      "actions": [
        "click_ud_loans_link()"
      ],
      "validations": [
        "is_loan_payment_guides_page_displayed()"
      ]
    },
    "UDLoansPaymentGuidePage": {
      "file_name": "ud_loans_payment_guide_page.py",
      "locators": {
        "expand_payment_options_icon": {"by": "PLACEHOLDER", "value": "//button[@aria-label='Expand Payment Options']"},
        "upay_link": {"by": "PLACEHOLDER", "value": "//a[contains(text(),'Click here to pay via UPAY')]"}
      },
      "actions": [
        "expand_payment_options()",
        "click_upay_link()"
      ],
      "validations": [
        "is_ud_loans_payment_guide_page_displayed()"
      ]
    },
    "LoanPaymentPage": {
      "file_name": "loan_payment_page.py",
      "locators": {
        "pay_via_upay_now_button": {"by": "PLACEHOLDER", "value": "//button[text()='PAY VIA UPAY NOW']"}
      },
      "actions": [
        "click_pay_via_upay_now()"
      ],
      "validations": [
        "is_loan_payment_page_displayed()"
      ]
    },
    "UDLoansByUnionDigitalBankPaymentPage": {
      "file_name": "ud_loans_by_uniondigital_bank_payment_page.py",
      "locators": {
        "loan_number_textbox": {"by": "PLACEHOLDER", "value": "//input[@name='loanNumber']"},
        "payment_amount_textbox": {"by": "PLACEHOLDER", "value": "//input[@name='paymentAmount']"}
      },
      "actions": [],
      "validations": [
        "is_ud_loans_by_uniondigital_bank_payment_page_displayed()",
        "are_loan_number_and_payment_amount_textboxes_displayed()"
      ]
    }
  }
}