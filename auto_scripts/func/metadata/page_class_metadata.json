{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "PLACEHOLDER", "value": "//tr[td[text()='Product A']]"},
        "product_d_row": {"by": "PLACEHOLDER", "value": "//tr[td[text()='Product D']]"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "subtotal_label": {"by": "PLACEHOLDER", "value": "//span[@class='subtotal']"},
        "cart_total_label": {"by": "PLACEHOLDER", "value": "//span[@class='cart-total']"},
        "loading_spinner": {"by": "PLACEHOLDER", "value": "//div[@class='spinner']"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity, subtotal)",
        "change_quantity(product_name, new_quantity)",
        "observe_line_item_subtotal(product_name)",
        "observe_cart_total()",
        "check_for_page_refresh()",
        "check_for_loading_spinner()"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_quantity(product_name, expected_quantity)",
        "validate_line_item_subtotal(product_name, expected_subtotal)",
        "validate_cart_total(expected_total)",
        "validate_no_page_refresh()",
        "validate_no_loading_spinner()"
      ]
    }
  }
}