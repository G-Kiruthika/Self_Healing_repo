{
  "pages": {
    "HomePage": {
      "file_name": "home_page.py",
      "locators": {
        "loan_payment_guides_link": {"by": "xpath", "value": "//a[text()='Loan Payment Guides']"},
        "ud_loans_link": {"by": "xpath", "value": "//a[text()='UD Loans']"},
        "upay_payment_option": {"by": "xpath", "value": "//div[contains(text(),'UPAY') or contains(text(),'Upay')]"},
        "how_to_pay_ud_loans_text": {"by": "xpath", "value": "//h2[contains(text(),'How To Pay Your UD Loans')]"},
        "plus_icon_right_of_text": {"by": "xpath", "value": "//h2[contains(text(),'How To Pay Your UD Loans')]/following-sibling::*[contains(@class,'plus-icon') or text()='+']"}
      },
      "actions": [
        "click_loan_payment_guides()",
        "click_ud_loans()"
      ],
      "validations": [
        "is_upay_payment_option_visible()",
        "is_loan_payment_guides_page_displayed()",
        "is_ud_loans_payment_guide_page_displayed()",
        "is_how_to_pay_ud_loans_text_visible()",
        "is_plus_icon_right_of_text_visible()"
      ]
    },
    "Browser": {
      "file_name": "browser.py",
      "locators": {},
      "actions": [
        "launch_browser(browser_name)",
        "navigate_to(url)"
      ],
      "validations": [
        "is_browser_launched()"
      ]
    }
  }
}