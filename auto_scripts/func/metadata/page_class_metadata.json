{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "XPATH", "value": "//tr[td[contains(text(),'Laptop Stand')]]"},
        "product_c_qty_input": {"by": "XPATH", "value": "//tr[td[contains(text(),'Laptop Stand')]]//input[@type='number']"},
        "cart_total": {"by": "ID", "value": "cart-total"},
        "inventory_error_msg": {"by": "CSS_SELECTOR", "value": ".inventory-error"}
      },
      "actions": [
        "update_product_quantity(product_name, quantity)",
        "view_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name, expected_qty, expected_stock)",
        "is_inventory_error_displayed()",
        "is_cart_total_correct()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_e_row": {"by": "XPATH", "value": "//tr[td[contains(text(),'USB Cable')]]"},
        "product_e_add_button": {"by": "XPATH", "value": "//tr[td[contains(text(),'USB Cable')]]//button[contains(text(),'Add')]"},
        "product_e_stock": {"by": "XPATH", "value": "//tr[td[contains(text(),'USB Cable')]]//span[contains(@class,'stock')]"},
        "inventory_error_msg": {"by": "CSS_SELECTOR", "value": ".inventory-error"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_stock_information_displayed(product_name)",
        "is_inventory_error_displayed()"
      ]
    }
  }
} 