{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_item": {"by": "XPATH", "value": "//div[@class='cart-item']"},
        "delete_button": {"by": "XPATH", "value": "//button[@aria-label='Delete']"},
        "empty_cart_message": {"by": "XPATH", "value": "//div[contains(text(),'Your cart is empty')]"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "return_to_catalog_button": {"by": "XPATH", "value": "//button[contains(text(),'Return to product catalog')]"},
        "line_item_subtotal": {"by": "XPATH", "value": "//span[@class='line-item-subtotal']"}
      },
      "actions": [
        "delete_product(product_name)",
        "add_product(product_name, quantity)",
        "navigate_to_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_cart_total(expected_total)",
        "is_line_item_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
}