{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username"},
        "password_input": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "loginBtn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_d_card": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']"},
        "add_to_cart_button": {"by": "XPATH", "value": "//button[contains(@data-product-id, 'D') and text()='Add to Cart']"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name, quantity)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_subscription_indicator_visible(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_d_row": {"by": "XPATH", "value": "//tr[@data-product-id='D']"},
        "subscription_indicator": {"by": "XPATH", "value": "//span[contains(@class, 'subscription-indicator')]"},
        "quantity_input": {"by": "XPATH", "value": "//input[@name='quantity' and @data-product-id='D']"},
        "subtotal_label": {"by": "XPATH", "value": "//td[@data-product-id='D']//span[@class='subtotal']"},
        "cart_total_label": {"by": "ID", "value": "cart-total"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_subscription_indicator_displayed(product_name)",
        "verify_product_subtotal(product_name, expected_subtotal)",
        "verify_cart_total(expected_total)"
      ]
    }
  }
}
