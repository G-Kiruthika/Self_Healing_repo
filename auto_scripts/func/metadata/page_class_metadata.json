{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_03": {"by": "xpath", "value": "//div[@data-sku='TD-03']"},
        "cart_item_td_01": {"by": "xpath", "value": "//div[@data-sku='TD-01']"},
        "quantity_input": {"by": "xpath", "value": "//input[@class='cart-qty']"},
        "increment_button": {"by": "xpath", "value": "//button[@aria-label='Increment']"},
        "max_quantity_message": {"by": "xpath", "value": "//div[contains(text(),'Maximum available quantity reached')]"},
        "subtotal": {"by": "xpath", "value": "//span[@class='line-item-subtotal']"},
        "confirmation_message": {"by": "xpath", "value": "//div[contains(text(),'Quantity updated in cart')]"}
      },
      "actions": [
        "set_cart_item_quantity(sku, quantity)",
        "increment_quantity(sku)",
        "navigate_to_cart()"
      ],
      "validations": [
        "verify_cart_item_quantity(sku, expected_quantity)",
        "verify_increment_button_disabled(sku)",
        "verify_max_quantity_message_displayed()",
        "verify_line_item_subtotal(sku, expected_subtotal)",
        "verify_confirmation_message_displayed()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "add_to_cart_button_td_01": {"by": "xpath", "value": "//button[@data-sku='TD-01' and contains(text(),'Add to Cart')]"}
      },
      "actions": [
        "navigate_to_product_catalog()",
        "add_to_cart(sku)"
      ],
      "validations": []
    }
  }
}