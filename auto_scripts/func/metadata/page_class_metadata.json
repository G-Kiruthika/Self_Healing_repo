        "password_input": {"by": "PLACEHOLDER", "value": "password_input_locator"},
        "login_button": {"by": "PLACEHOLDER", "value": "login_button_locator"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "validate_login_success()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
