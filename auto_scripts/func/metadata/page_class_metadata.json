{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "add_product_button": {"by": "placeholder", "value": "//button[@id='add-to-cart']"},
        "product_quantity_field": {"by": "placeholder", "value": "//input[@id='product-quantity']"},
        "remove_product_button": {"by": "placeholder", "value": "//button[@id='remove-product']"},
        "cart_contents": {"by": "placeholder", "value": "//div[@id='cart-contents']"}
      },
      "actions": [
        "add_product_to_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "remove_product_from_cart(product_name)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_updated_instantly()",
        "is_no_negative_quantity_in_cart()"
      ]
    }
  }
}