{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_01": {"by": "id", "value": "cart-item-td-01"},
        "cart_item_td_02": {"by": "id", "value": "cart-item-td-02"},
        "quantity_field": {"by": "id", "value": "quantity-field"},
        "update_button": {"by": "id", "value": "update-btn"},
        "validation_error_message": {"by": "id", "value": "error-msg"},
        "cart_totals": {"by": "id", "value": "cart-totals"},
        "decrement_button": {"by": "id", "value": "decrement-btn"},
        "increment_button": {"by": "id", "value": "increment-btn"},
        "line_item_subtotal": {"by": "id", "value": "line-item-subtotal"},
        "threshold_indicator": {"by": "id", "value": "threshold-indicator"}
      },
      "actions": [
        "set_quantity(quantity)",
        "click_update_button()",
        "click_decrement_button()",
        "click_increment_button()"
      ],
      "validations": [
        "validate_cart_item_quantity(item, quantity)",
        "validate_error_message(expected_message)",
        "validate_cart_totals(expected_totals)",
        "validate_button_state(button, expected_state)",
        "validate_line_item_subtotal(item, expected_subtotal)",
        "validate_threshold_indicator(item, expected_indicator)"
      ]
    }
  }
}