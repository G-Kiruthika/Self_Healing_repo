{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_item": {"by": "PLACEHOLDER", "value": "//div[@class='cart-item' and .//span[text()='Product Name']]"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[@class='delete-product']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(),'Return to product catalog')]"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[@class='line-item-subtotal']"}
      },
      "actions": [
        "add_product(product_name, quantity)",
        "delete_product(product_name)",
        "navigate_to_cart()",
        "return_to_catalog()"
      ],
      "validations": [
        "validate_product_in_cart(product_name)",
        "validate_product_not_in_cart(product_name)",
        "validate_empty_cart_message()",
        "validate_cart_total(expected_total)",
        "validate_line_item_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
} 