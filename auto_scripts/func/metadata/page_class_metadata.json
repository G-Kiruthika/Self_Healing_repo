{
  "pages": {
    "ExperianHomePage": {
      "file_name": "experian_home_page.py",
      "locators": {
        "how_can_we_help_section": {"by": "xpath", "value": "//section[contains(., 'How can we help?')]"},
        "disputes_card_link": {"by": "xpath", "value": "//a[contains(., 'Disputes')]"},
        "fraud_alert_card_link": {"by": "xpath", "value": "//a[contains(., 'Fraud alert')]"}
      },
      "actions": [
        "navigate_to_homepage(url)",
        "scroll_to_how_can_we_help_section()",
        "click_disputes_card()",
        "click_fraud_alert_card()"
      ],
      "validations": [
        "validate_on_disputes_page()",
        "validate_on_fraud_alert_page()"
      ]
    }
  }
}