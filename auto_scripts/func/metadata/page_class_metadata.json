{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "//tr[@data-product-id='{product_id}']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@data-product-id='{product_id}']"},
        "increment_button": {"by": "PLACEHOLDER", "value": "//button[@data-action='increment'][@data-product-id='{product_id}']"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[@data-action='delete'][@data-product-id='{product_id}']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "confirmation_message": {"by": "PLACEHOLDER", "value": "//div[@class='confirmation-message']"}
      },
      "actions": [
        "ensure_cart_contains(product_id, quantity, subtotal)",
        "click_increment(product_id)",
        "click_delete(product_id)"
      ],
      "validations": [
        "validate_cart_item(product_id, quantity, subtotal)",
        "validate_cart_total(total)",
        "validate_no_page_reload()",
        "validate_confirmation_message(message)"
      ]
    }
  }
}