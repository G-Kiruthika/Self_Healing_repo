{
  "pages": {
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "out_of_stock_indicator": {"by": "xpath", "value": "//span[contains(text(),'Out of Stock')]"},
        "add_to_cart_button": {"by": "id", "value": "add-to-cart-btn"},
        "error_message": {"by": "css selector", "value": ".error-message"},
        "cart_icon": {"by": "id", "value": "cart-icon"}
      },
      "actions": [
        "view_product(product_id)",
        "click_add_to_cart()"
      ],
      "validations": [
        "is_out_of_stock_displayed()",
        "is_add_to_cart_disabled()",
        "is_error_message_displayed()",
        "is_cart_unchanged()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "xpath", "value": "//tr[@data-product-id]"},
        "quantity_field": {"by": "css selector", "value": ".quantity-input"},
        "decrement_button": {"by": "css selector", "value": ".decrement-btn"},
        "validation_error_message": {"by": "css selector", "value": ".validation-error"}
      },
      "actions": [
        "click_decrement(product_id)"
      ],
      "validations": [
        "is_product_quantity_displayed(product_id, quantity)",
        "is_minimum_threshold_displayed(product_id, threshold)",
        "is_validation_error_displayed()",
        "is_quantity_unchanged(product_id, quantity)",
        "is_decrement_button_disabled(product_id)"
      ]
    }
  }
}