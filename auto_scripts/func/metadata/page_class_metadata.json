{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_quantity_input": {"by": "ID", "value": "product-quantity-input"},
        "add_to_cart_button": {"by": "ID", "value": "add-to-cart-btn"},
        "update_cart_button": {"by": "ID", "value": "update-cart-btn"},
        "cart_contents": {"by": "ID", "value": "cart-contents"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)",
        "click_add_to_cart(product_name)",
        "click_update_cart()"
      ],
      "validations": [
        "validate_quantity_not_changed(product_name)",
        "validate_no_product_with_quantity(product_name, quantity)"
      ]
    }
  }
}