{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username"},
        "password_input": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "login-btn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_d_card": {"by": "XPATH", "value": "//div[@data-product='Vitamin Pack']"},
        "add_to_cart_button": {"by": "XPATH", "value": "//button[@data-product='Vitamin Pack'][text()='Add to Cart']"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name, quantity)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_subscription_indicator_visible(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_d_row": {"by": "XPATH", "value": "//tr[@data-product='Vitamin Pack']"},
        "quantity_input": {"by": "XPATH", "value": "//input[@data-product='Vitamin Pack'][@type='number']"},
        "subscription_indicator": {"by": "XPATH", "value": "//span[@data-product='Vitamin Pack'][@class='subscription']"},
        "subtotal_label": {"by": "XPATH", "value": "//tr[@data-product='Vitamin Pack']//td[@class='subtotal']"},
        "cart_total_label": {"by": "ID", "value": "cart-total"}
      },
      "actions": [
        "update_product_quantity(product_name, quantity)"
      ],
      "validations": [
        "is_product_in_cart(product_name, quantity)",
        "is_subscription_indicator_visible(product_name)",
        "verify_subtotal(product_name, expected_subtotal)",
        "verify_cart_total(expected_total)"
      ]
    }
  }
}