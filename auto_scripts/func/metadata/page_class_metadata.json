{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "PLACEHOLDER", "value": "//tr[td[contains(text(),'Wireless Mouse')]]"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "remove_button": {"by": "PLACEHOLDER", "value": "//button[@aria-label='Remove']"},
        "cart_totals": {"by": "PLACEHOLDER", "value": "//div[@id='cart-totals']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'empty cart')]"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)",
        "remove_product(product_name)",
        "check_cart_totals()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_empty_cart_message_displayed()"
      ]
    },
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "PLACEHOLDER", "value": "//input[@name='username']"},
        "password_input": {"by": "PLACEHOLDER", "value": "//input[@name='password']"},
        "login_button": {"by": "PLACEHOLDER", "value": "//button[@type='submit']"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "//tr[td[contains(text(),'Organic Green Tea - 100g')]]"},
        "add_to_cart_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(),'Add to Cart')]"},
        "stock_indicator": {"by": "PLACEHOLDER", "value": "//span[@class='stock']"}
      },
      "actions": [
        "find_product(product_name)",
        "add_to_cart(product_name)"
      ],
      "validations": [
        "is_product_in_stock(product_name)"
      ]
    },
    "ConfirmationPage": {
      "file_name": "confirmation_page.py",
      "locators": {
        "confirmation_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Product added to cart')]"}
      },
      "actions": [],
      "validations": [
        "is_confirmation_message_displayed()"
      ]
    }
  }
}