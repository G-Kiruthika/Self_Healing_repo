{
  "pages": {
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "out_of_stock_indicator": {"by": "xpath", "value": "//span[contains(text(), 'Out of Stock')]"},
        "add_to_cart_button": {"by": "id", "value": "add-to-cart-btn"},
        "error_message": {"by": "xpath", "value": "//div[@class='error-message']"},
        "cart_icon": {"by": "id", "value": "cart-icon"}
      },
      "actions": [
        "view_product(product_code)",
        "click_add_to_cart()"
      ],
      "validations": [
        "is_out_of_stock_displayed()",
        "is_add_to_cart_disabled()",
        "is_error_message_displayed(expected_message)",
        "is_cart_unchanged()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "xpath", "value": "//tr[@data-product-code='{product_code}']"},
        "quantity_field": {"by": "xpath", "value": "//input[@name='quantity']"},
        "decrement_button": {"by": "id", "value": "decrement-btn"},
        "validation_error_message": {"by": "xpath", "value": "//div[@class='validation-error']"}
      },
      "actions": [
        "view_cart()",
        "click_decrement(product_code)"
      ],
      "validations": [
        "is_product_in_cart(product_code, quantity)",
        "is_validation_error_displayed(expected_message)",
        "is_decrement_disabled(product_code)",
        "is_quantity_unchanged(product_code, expected_quantity)"
      ]
    }
  }
}