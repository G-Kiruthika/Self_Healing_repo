        "cart_totals": {"by": "PLACEHOLDER", "value": "cart_totals_locator"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "empty_cart_message_locator"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity)",
