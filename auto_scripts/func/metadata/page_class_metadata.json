{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_01": {"by": "PLACEHOLDER", "value": "//div[@data-sku='TD-01']"},
        "cart_item_td_02": {"by": "PLACEHOLDER", "value": "//div[@data-sku='TD-02']"},
        "quantity_field": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "update_button": {"by": "PLACEHOLDER", "value": "//button[@id='update-cart']"},
        "validation_error_message": {"by": "PLACEHOLDER", "value": "//div[@class='error-message']"},
        "decrement_button": {"by": "PLACEHOLDER", "value": "//button[@class='decrement']"},
        "increment_button": {"by": "PLACEHOLDER", "value": "//button[@class='increment']"},
        "cart_totals": {"by": "PLACEHOLDER", "value": "//div[@id='cart-totals']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[@class='line-subtotal']"},
        "threshold_indicator": {"by": "PLACEHOLDER", "value": "//span[contains(text(),'Min:')]"}
      },
      "actions": [
        "enter_quantity(value)",
        "click_update_cart()",
        "click_increment_button()",
        "click_decrement_button()"
      ],
      "validations": [
        "validate_cart_item_quantity(sku, expected_quantity)",
        "validate_error_message(expected_message)",
        "validate_cart_totals(expected_totals)",
        "validate_button_enabled(button_name)",
        "validate_line_item_subtotal(sku, expected_subtotal)",
        "validate_threshold_indicator(sku, expected_indicator)"
      ]
    }
  }
}