{
  "pages": {
    "InventoryPage": {
      "file_name": "inventory_page.py",
      "locators": {
        "stock_quantity_label": {"by": "ID", "value": "stock_quantity_label"},
        "procurement_threshold_label": {"by": "ID", "value": "procurement_threshold_label"},
        "quantity_input": {"by": "ID", "value": "quantity_input"},
        "add_to_cart_button": {"by": "ID", "value": "add_to_cart_button"},
        "cart_icon": {"by": "ID", "value": "cart_icon"}
      },
      "actions": [
        "check_stock_quantity(product_name)",
        "check_procurement_threshold(product_name)",
        "set_quantity(quantity)",
        "add_product_to_cart(product_name, quantity)",
        "open_cart()"
      ],
      "validations": [
        "validate_stock_quantity(expected_quantity)",
        "validate_procurement_threshold(expected_threshold)",
        "validate_cart_product_quantity(product_name, expected_quantity)",
        "validate_product_in_cart(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_product_list": {"by": "ID", "value": "cart_product_list"},
        "product_quantity_label": {"by": "ID", "value": "product_quantity_label"}
      },
      "actions": [
        "get_cart_products()",
        "get_product_quantity(product_name)"
      ],
      "validations": [
        "validate_cart_contains_product(product_name, expected_quantity)"
      ]
    }
  }
}