{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_field": {"by": "ID", "value": "username"},
        "password_field": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "loginBtn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_d_card": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']"},
        "add_to_cart_button": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']//button[contains(text(),'Add to Cart')]"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name, quantity)"
      ],
      "validations": [
        "is_product_visible(product_name)",
        "is_subscription_indicator_visible(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_row": {"by": "XPATH", "value": "//tr[@data-product-name='Vitamin Pack']"},
        "subscription_indicator": {"by": "XPATH", "value": "//tr[@data-product-name='Vitamin Pack']//span[contains(@class,'subscription')]"},
        "quantity_input": {"by": "XPATH", "value": "//tr[@data-product-name='Vitamin Pack']//input[@type='number']"},
        "line_item_subtotal": {"by": "XPATH", "value": "//tr[@data-product-name='Vitamin Pack']//td[@class='subtotal']"},
        "cart_total": {"by": "ID", "value": "cartTotal"}
      },
      "actions": [
        "increase_quantity(product_name, amount)",
        "get_line_item_subtotal(product_name)",
        "get_cart_total()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_subscription_indicator_displayed(product_name)",
        "verify_subtotal(product_name, expected_subtotal)",
        "verify_cart_total(expected_total)"
      ]
    }
  }
}