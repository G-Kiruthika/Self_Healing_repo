{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username"},
        "password_input": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "login-btn"}
      },
      "actions": [
        "enter_username(username)",
        "enter_password(password)",
        "click_login()"
      ],
      "validations": [
        "is_login_successful()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_d_tile": {"by": "XPATH", "value": "//div[contains(@class,'product') and .//h2[text()='Vitamin Pack']]"},
        "add_to_cart_button": {"by": "XPATH", "value": "//div[contains(@class,'product') and .//h2[text()='Vitamin Pack']]//button[text()='Add to Cart']"}
      },
      "actions": [
        "navigate_to_product_catalog()",
        "locate_product_d()",
        "click_add_to_cart_for_product_d()"
      ],
      "validations": [
        "is_product_d_visible()"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_product_d_row": {"by": "XPATH", "value": "//tr[td[contains(text(),'Vitamin Pack')]]"},
        "subscription_indicator": {"by": "XPATH", "value": "//tr[td[contains(text(),'Vitamin Pack')]]//span[contains(@class,'subscription')]"},
        "quantity_input": {"by": "XPATH", "value": "//tr[td[contains(text(),'Vitamin Pack')]]//input[@type='number']"},
        "subtotal_cell": {"by": "XPATH", "value": "//tr[td[contains(text(),'Vitamin Pack')]]//td[contains(@class,'subtotal')]"},
        "cart_total": {"by": "ID", "value": "cart-total"}
      },
      "actions": [
        "check_subscription_indicator_for_product_d()",
        "increase_quantity_for_product_d(quantity)",
        "get_line_item_subtotal_for_product_d()",
        "get_cart_total()"
      ],
      "validations": [
        "is_product_d_in_cart()",
        "is_subscription_indicator_displayed_for_product_d()",
        "is_subtotal_correct_for_product_d(expected_subtotal)",
        "is_cart_total_correct(expected_total)"
      ]
    }
  }
}