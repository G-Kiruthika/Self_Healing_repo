{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "empty_cart_message": {"by": "xpath", "value": "//div[contains(text(), 'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "xpath", "value": "//button[contains(text(), 'Return to catalog')]"},
        "cart_item": {"by": "css_selector", "value": ".cart-item"},
        "quantity_input": {"by": "css_selector", "value": ".cart-item-qty-input"},
        "increase_quantity_button": {"by": "css_selector", "value": ".cart-item-increase-btn"},
        "inventory_error_message": {"by": "xpath", "value": "//div[contains(@class, 'inventory-error')]"}
      },
      "actions": [
        "open_cart_page()",
        "add_item_to_cart(item_name, quantity)",
        "increase_item_quantity(item_name)",
        "return_to_catalog()"
      ],
      "validations": [
        "is_cart_empty()",
        "is_cart_page_displayed()",
        "is_item_in_cart(item_name, quantity)",
        "is_inventory_error_displayed()"
      ]
    }
  }
}
