{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_empty_message": {"by": "xpath", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "id", "value": "return-to-catalog-btn"},
        "cart_item": {"by": "css selector", "value": ".cart-item"},
        "quantity_field": {"by": "name", "value": "quantity"},
        "error_message": {"by": "class name", "value": "inventory-error"}
      },
      "actions": [
        "open_cart_page()",
        "add_item_to_cart(item_name, quantity)",
        "increase_quantity(item_name, quantity)",
        "click_return_to_catalog()"
      ],
      "validations": [
        "is_cart_empty()",
        "is_cart_page_displayed()",
        "is_item_in_cart(item_name, quantity)",
        "is_error_message_displayed()"
      ]
    }
  }
}