{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_field": {"by": "ID", "value": "username_input"},
        "password_field": {"by": "ID", "value": "password_input"},
        "login_button": {"by": "ID", "value": "login_btn"}
      },
      "actions": [
        "login(username, password)"
      ],
      "validations": [
        "is_logged_in()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_d_card": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']"},
        "add_to_cart_button": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']//button[contains(@class,'add-to-cart')]"}
      },
      "actions": [
        "navigate_to()",
        "add_product_to_cart(product_name)"
      ],
      "validations": [
        "is_product_visible(product_name)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "subscription_indicator": {"by": "CSS_SELECTOR", "value": ".cart-item .subscription-indicator"},
        "product_quantity_field": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']//input[@type='number']"},
        "product_subtotal": {"by": "XPATH", "value": "//div[@data-product-name='Vitamin Pack']//span[contains(@class,'subtotal')]"},
        "cart_total": {"by": "ID", "value": "cart_total_value"}
      },
      "actions": [
        "set_product_quantity(product_name, quantity)",
        "navigate_to()"
      ],
      "validations": [
        "is_subscription_indicator_displayed(product_name)",
        "verify_product_subtotal(product_name, expected_subtotal)",
        "verify_cart_total(expected_total)",
        "is_product_in_cart(product_name)"
      ]
    }
  }
}