{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_03": {"by": "xpath", "value": "//div[@data-sku='TD-03']"},
        "cart_item_td_01": {"by": "xpath", "value": "//div[@data-sku='TD-01']"},
        "quantity_input": {"by": "css selector", "value": ".cart-quantity-input"},
        "increment_button": {"by": "css selector", "value": ".cart-increment-btn"},
        "decrement_button": {"by": "css selector", "value": ".cart-decrement-btn"},
        "max_quantity_message": {"by": "css selector", "value": ".max-quantity-message"},
        "subtotal_label": {"by": "css selector", "value": ".cart-item-subtotal"},
        "confirmation_message": {"by": "css selector", "value": ".confirmation-message"}
      },
      "actions": [
        "set_cart_item_quantity(sku, quantity)",
        "increment_quantity(sku)",
        "decrement_quantity(sku)"
      ],
      "validations": [
        "verify_cart_item_quantity(sku, expected_quantity)",
        "verify_increment_button_disabled(sku)",
        "verify_max_quantity_message_displayed()",
        "verify_subtotal(sku, expected_subtotal)",
        "verify_confirmation_message(message)"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "add_to_cart_button": {"by": "css selector", "value": ".add-to-cart-btn"},
        "product_td_01": {"by": "xpath", "value": "//div[@data-sku='TD-01']"}
      },
      "actions": [
        "click_add_to_cart(sku)"
      ],
      "validations": []
    }
  }
}