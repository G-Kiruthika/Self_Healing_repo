{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Laptop Stand')]]"},
        "product_b_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Coffee Subscription')]]"},
        "quantity_input": {"by": "css selector", "value": "input.qty-input"},
        "subtotal_label": {"by": "css selector", "value": ".line-item-subtotal"},
        "error_message": {"by": "css selector", "value": ".cart-error-message"},
        "warning_message": {"by": "css selector", "value": ".cart-warning-message"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity)",
        "update_quantity(product_name, quantity)",
        "check_line_item_subtotal(product_name)",
        "check_error_messages()",
        "attempt_reduce_quantity(product_name, quantity)",
        "check_cart_quantity(product_name)"
      ],
      "validations": [
        "validate_product_in_cart(product_name, quantity)",
        "validate_subtotal(product_name, expected_subtotal)",
        "validate_no_inventory_error()",
        "validate_warning_message()",
        "validate_quantity_threshold(product_name, expected_quantity)"
      ]
    }
  }
}
