{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_item": {"by": "PLACEHOLDER", "value": "//div[@class='cart-item']"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[@class='delete']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[@class='cart-empty']"},
        "return_to_catalog_button": {"by": "PLACEHOLDER", "value": "//button[@id='return-catalog']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[@class='line-subtotal']"}
      },
      "actions": [
        "delete_product(product_name)",
        "return_to_catalog()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_message_displayed(message)",
        "is_cart_total(expected_total)",
        "is_line_item_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
}