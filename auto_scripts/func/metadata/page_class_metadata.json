{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_01": {"by": "ID", "value": "cart-item-td-01"},
        "cart_item_td_02": {"by": "ID", "value": "cart-item-td-02"},
        "increment_button_td_01": {"by": "XPATH", "value": "//button[@data-product-id='TD-01' and @class='increment']"},
        "delete_button_td_01": {"by": "XPATH", "value": "//button[@data-product-id='TD-01' and contains(@class,'delete')]"},
        "cart_total": {"by": "ID", "value": "cart-total"},
        "confirmation_message": {"by": "ID", "value": "confirmation-message"}
      },
      "actions": [
        "ensure_cart_contains(product_code, quantity, subtotal)",
        "click_increment(product_code)",
        "click_delete(product_code)"
      ],
      "validations": [
        "validate_cart_item(product_code, quantity, subtotal)",
        "validate_cart_total(total_amount)",
        "validate_no_page_reload()",
        "validate_confirmation_message(message)"
      ]
    }
  }
}