{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "username_input": {"by": "ID", "value": "username"},
        "password_input": {"by": "ID", "value": "password"},
        "login_button": {"by": "ID", "value": "loginBtn"},
        "subscription_badge": {"by": "XPATH", "value": "//span[contains(@class, 'subscription-badge')]"}
      },
      "actions": [
        "login(username, password)",
        "login_as_premium(username, password)"
      ],
      "validations": [
        "verify_logged_in()",
        "verify_premium_subscription()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_card": {"by": "XPATH", "value": "//div[contains(@class, 'product-card') and .//span[contains(text(), '{product_name}')]]"},
        "add_to_cart_button": {"by": "XPATH", "value": "//button[contains(@class, 'add-to-cart')]"},
        "subscription_option": {"by": "ID", "value": "subscriptionOption"},
        "min_threshold_indicator": {"by": "XPATH", "value": "//span[contains(@class, 'min-threshold')]"}
      },
      "actions": [
        "browse_product(product_name)",
        "add_to_cart(product_code)",
        "select_subscription_option(product_code)"
      ],
      "validations": [
        "verify_product_visible(product_code)",
        "verify_minimum_threshold(product_code)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_product_name": {"by": "XPATH", "value": "//td[contains(@class, 'cart-product-name')]"},
        "cart_unit_price": {"by": "XPATH", "value": "//td[contains(@class, 'cart-unit-price')]"},
        "cart_quantity": {"by": "XPATH", "value": "//input[contains(@class, 'cart-quantity')]"},
        "cart_subtotal": {"by": "XPATH", "value": "//td[contains(@class, 'cart-subtotal')]"},
        "min_threshold_indicator": {"by": "XPATH", "value": "//span[contains(@class, 'min-threshold')]"},
        "subscription_badge": {"by": "XPATH", "value": "//span[contains(@class, 'subscription-badge')]"},
        "delivery_frequency": {"by": "ID", "value": "deliveryFrequency"}
      },
      "actions": [
        "view_cart()"
      ],
      "validations": [
        "verify_cart_details(product_code)",
        "verify_minimum_threshold_in_cart(product_code)",
        "verify_subscription_badge(product_code)",
        "verify_delivery_frequency(product_code)"
      ]
    }
  }
}