{
  "RootViewScreen": {
    "class_name": "RootViewScreen",
    "locators": {
      "printer_icon": {"by": "id", "value": "printer_icon_id_placeholder"}
    },
    "actions": [
      {"name": "click_printer_icon", "element": "printer_icon", "type": "click"}
    ]
  },
  "DeviceDetailsPage": {
    "class_name": "DeviceDetailsPage",
    "locators": {
      "shortcuts_tile": {"by": "id", "value": "shortcuts_tile_id_placeholder"}
    },
    "actions": [
      {"name": "click_shortcuts_tile", "element": "shortcuts_tile", "type": "click"}
    ]
  },
  "ShortcutsScreen": {
    "class_name": "ShortcutsScreen",
    "locators": {
      "add_new_shortcut_btn": {"by": "id", "value": "add_new_shortcut_btn_id_placeholder"}
    },
    "actions": [
      {"name": "click_add_new_shortcut", "element": "add_new_shortcut_btn", "type": "click"}
    ]
  },
  "CreateShortcutScreen": {
    "class_name": "CreateShortcutScreen",
    "locators": {
      "create_shortcut_arrow": {"by": "id", "value": "create_shortcut_arrow_id_placeholder"}
    },
    "actions": [
      {"name": "click_create_shortcut_arrow", "element": "create_shortcut_arrow", "type": "click"}
    ]
  },
  "AddShortcutScreen": {
    "class_name": "AddShortcutScreen",
    "locators": {
      "save_toggle": {"by": "id", "value": "save_toggle_id_placeholder"},
      "continue_button": {"by": "id", "value": "continue_button_id_placeholder"},
      "screen_verification": {"by": "xpath", "value": "//android.widget.TextView[@text='Add Save']"}
    },
    "actions": [
      {"name": "enable_save_toggle", "element": "save_toggle", "type": "toggle", "toggle_state": "on"},
      {"name": "click_continue", "element": "continue_button", "type": "click"}
    ],
    "validations": [
      {"name": "verify_add_save_screen", "element": "screen_verification", "type": "visible"}
    ]
  },
  "AddPrintScreen": {
    "class_name": "AddPrintScreen",
    "locators": {
      "back_button": {"by": "id", "value": "back_button_id_placeholder"},
      "screen_verification": {"by": "xpath", "value": "//android.widget.TextView[@text='Add Shortcut']"}
    },
    "actions": [
      {"name": "click_back_button", "element": "back_button", "type": "click"}
    ],
    "validations": [
      {"name": "verify_add_shortcut_screen", "element": "screen_verification", "type": "visible"}
    ]
  }
}
