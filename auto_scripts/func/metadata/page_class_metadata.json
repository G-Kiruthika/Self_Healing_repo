{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_item": {"by": "PLACEHOLDER", "value": "//div[@class='cart-item']"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[contains(@aria-label,'Delete')]"},
        "cart_empty_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(),'Return to catalog')]"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[contains(@class,'line-item-subtotal')]"}
      },
      "actions": [
        "delete_product(product_name)",
        "add_product(product_name, quantity)",
        "navigate_to_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_cart_total(amount)",
        "is_line_item_subtotal(product_name, expected_subtotal)"
      ]
    }
  }
}