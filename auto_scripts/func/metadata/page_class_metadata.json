{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "xpath", "value": "//tr[contains(., 'Product A')]"},
        "product_c_row": {"by": "xpath", "value": "//tr[contains(., 'Product C')]"},
        "delete_product_c_button": {"by": "xpath", "value": "//tr[contains(., 'Product C')]//button[text()='Delete']"},
        "cart_total": {"by": "id", "value": "cart-total"},
        "empty_cart_message": {"by": "xpath", "value": "//div[contains(text(), 'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "xpath", "value": "//button[text()='Return to Product Catalog']"}
      },
      "actions": [
        "navigate_to_cart()",
        "delete_product(product_name)",
        "observe_cart_page()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_product_not_in_cart(product_name)",
        "is_cart_total(expected_total)",
        "is_only_product_in_cart(product_name)",
        "is_cart_empty()",
        "is_empty_cart_message_displayed()",
        "is_return_to_catalog_button_displayed()"
      ]
    }
  }
}