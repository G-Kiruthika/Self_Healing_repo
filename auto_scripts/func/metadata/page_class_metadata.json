{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_name": {"by": "XPATH", "value": "//div[@class='cart-item']//span[@class='product-name']"},
        "unit_price": {"by": "XPATH", "value": "//div[@class='cart-item']//span[@class='unit-price']"},
        "quantity_field": {"by": "XPATH", "value": "//input[@class='quantity-input']"},
        "subtotal": {"by": "XPATH", "value": "//div[@class='cart-item']//span[@class='subtotal']"},
        "cart_total": {"by": "XPATH", "value": "//span[@id='cart-total']"},
        "update_quantity_button": {"by": "XPATH", "value": "//button[@id='update-quantity']"},
        "success_message": {"by": "XPATH", "value": "//div[@class='alert-success']"}
      },
      "actions": [
        "navigate_to_cart()",
        "enter_quantity(quantity)",
        "update_quantity()"
      ],
      "validations": [
        "is_cart_loaded()",
        "verify_product_in_cart(product_name)",
        "verify_unit_price(product_name, price)",
        "verify_quantity(product_name, quantity)",
        "verify_subtotal(product_name, subtotal)",
        "verify_cart_total(total)",
        "verify_success_message(message)"
      ]
    }
  }
}