{
  "pages": {
    "HomePage": {
      "file_name": "home_page.py",
      "locators": {
        "loan_payment_guides_link": {"by": "xpath", "value": "//a[text()='Loan Payment Guides']"}
      },
      "actions": [
        "click_loan_payment_guides()"
      ],
      "validations": [
        "is_homepage_displayed()"
      ]
    },
    "LoanPaymentGuidesPage": {
      "file_name": "loan_payment_guides_page.py",
      "locators": {
        "ud_loans_link": {"by": "xpath", "value": "//a[text()='UD Loans']"}
      },
      "actions": [
        "click_ud_loans()"
      ],
      "validations": [
        "is_loan_payment_guides_page_displayed()"
      ]
    },
    "UDLoansPaymentGuidePage": {
      "file_name": "ud_loans_payment_guide_page.py",
      "locators": {
        "plus_icon": {"by": "xpath", "value": "//span[@class='icon-plus']"},
        "how_to_pay_your_ud_loans_text": {"by": "xpath", "value": "//h2[contains(text(),'How To Pay Your UD Loans')]"},
        "upay_section": {"by": "xpath", "value": "//section[contains(text(),'Pay through your other bank accounts or e-wallets via UPAY.')]"},
        "click_here_to_pay_via_upay_link": {"by": "xpath", "value": "//a[contains(text(),'Click here to pay via UPAY')]"}
      },
      "actions": [
        "click_plus_icon()"
      ],
      "validations": [
        "is_ud_loans_payment_guide_page_displayed()",
        "is_plus_icon_located()",
        "is_payment_option_details_displayed()",
        "is_upay_section_located()",
        "is_click_here_to_pay_via_upay_link_visible()"
      ]
    }
  }
}
