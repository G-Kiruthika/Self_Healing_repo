{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_01": {"by": "css_selector", "value": "[data-product-id='TD-01']"},
        "cart_item_td_02": {"by": "css_selector", "value": "[data-product-id='TD-02']"},
        "increment_button": {"by": "css_selector", "value": ".cart-item-increment"},
        "delete_button": {"by": "css_selector", "value": ".cart-item-delete"},
        "confirmation_message": {"by": "css_selector", "value": ".cart-message"},
        "subtotal": {"by": "css_selector", "value": ".cart-subtotal"},
        "cart_total": {"by": "css_selector", "value": ".cart-total"}
      },
      "actions": [
        "increment_product_quantity(product_id)",
        "delete_product(product_id)"
      ],
      "validations": [
        "verify_cart_contains(product_id, quantity, subtotal)",
        "verify_cart_total(expected_total)",
        "verify_no_page_reload()",
        "verify_confirmation_message(expected_message)"
      ]
    }
  }
}