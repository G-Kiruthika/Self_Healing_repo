{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "PLACEHOLDER", "value": "//row[contains(text(), 'Laptop Stand')]"},
        "product_c_qty_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "update_qty_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(), 'Update')]"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//div[@id='cart-total']"},
        "inventory_error_message": {"by": "PLACEHOLDER", "value": "//div[@class='error-message']"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "check_cart_totals()"
      ],
      "validations": [
        "validate_product_in_cart(product_name, quantity, stock)",
        "validate_inventory_error_displayed()",
        "validate_cart_totals(expected_total)"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "product_e_row": {"by": "PLACEHOLDER", "value": "//row[contains(text(), 'USB Cable')]"},
        "add_to_cart_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(), 'Add to cart')]"},
        "stock_info": {"by": "PLACEHOLDER", "value": "//span[@class='stock-info']"}
      },
      "actions": [
        "navigate_to_product_catalog()",
        "locate_product(product_name)",
        "attempt_add_to_cart(product_name)"
      ],
      "validations": [
        "validate_product_visible(product_name)",
        "validate_stock_info(product_name, stock)",
        "validate_inventory_error_displayed()"
      ]
    }
  }
}