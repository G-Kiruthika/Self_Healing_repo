{
  "pages": {
    "ProductPage": {
      "file_name": "product_page.py",
      "locators": {
        "available_stock_label": {"by": "xpath", "value": "//span[@id='available_stock']"},
        "product_quantity_input": {"by": "xpath", "value": "//input[@id='quantity']"},
        "add_to_cart_button": {"by": "xpath", "value": "//button[@id='add_to_cart']"},
        "minimum_procurement_label": {"by": "xpath", "value": "//span[@id='min_procurement']"}
      },
      "actions": [
        "check_available_stock(product_name)",
        "set_quantity(quantity)",
        "add_to_cart()",
        "check_minimum_procurement(product_name)"
      ],
      "validations": [
        "validate_available_stock(expected_stock)",
        "validate_minimum_procurement(expected_threshold)"
      ]
    },
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_contents": {"by": "xpath", "value": "//div[@id='cart_contents']"},
        "cart_product_quantity": {"by": "xpath", "value": "//span[@class='product_quantity']"}
      },
      "actions": [
        "view_cart()"
      ],
      "validations": [
        "validate_product_in_cart(product_name, quantity)",
        "validate_cart_quantity(product_name, expected_quantity)"
      ]
    }
  }
}