{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "XPATH", "value": "//tr[td[text()='Product A']]"},
        "product_c_row": {"by": "XPATH", "value": "//tr[td[text()='Product C']]"},
        "delete_button_product_c": {"by": "XPATH", "value": "//tr[td[text()='Product C']]//button[text()='Delete']"},
        "cart_total": {"by": "ID", "value": "cart-total"},
        "empty_cart_message": {"by": "XPATH", "value": "//*[contains(text(),'Your cart is empty')]"},
        "return_to_product_catalog_button": {"by": "XPATH", "value": "//button[text()='Return to Product Catalog']"}
      },
      "actions": [
        "delete_product(product_name)",
        "navigate_to_cart()"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "is_cart_total(expected_total)",
        "is_cart_empty()",
        "is_empty_cart_message_displayed()",
        "is_return_to_product_catalog_button_displayed()"
      ]
    }
  }
}
