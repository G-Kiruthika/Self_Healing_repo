{
  "pages": {
    "LoginPage": {
      "file_name": "login_page.py",
      "locators": {
        "email_input": {"by": "ID", "value": "email"},
        "password_input": {"by": "ID", "value": "password"},
        "sign_in_button": {"by": "XPATH", "value": "//button[text()='Sign In']"},
        "error_banner": {"by": "CSS_SELECTOR", "value": ".error-banner"}
      },
      "actions": [
        "navigate_to_login_page()",
        "enter_email(email)",
        "enter_password(password)",
        "click_sign_in()",
        "clear_inputs()"
      ],
      "validations": [
        "is_authenticated()",
        "is_error_banner_displayed()",
        "is_password_field_cleared()",
        "is_input_highlighted_with_error()"
      ]
    },
    "DashboardPage": {
      "file_name": "dashboard_page.py",
      "locators": {
        "sidebar_avatar": {"by": "CSS_SELECTOR", "value": ".sidebar-avatar"},
        "profile_name": {"by": "CSS_SELECTOR", "value": ".sidebar-profile-name"}
      },
      "actions": [],
      "validations": [
        "is_dashboard_loaded()",
        "is_avatar_and_profile_displayed()"
      ]
    }
  }
}