{
  "pages": {
    "ShoppingCartPage": {
      "file_name": "shopping_cart_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "//div[@class='product-row']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "update_button": {"by": "PLACEHOLDER", "value": "//button[@id='update-cart']"}
      },
      "actions": [
        "add_product_to_cart(product_name, quantity)",
        "navigate_to_cart()",
        "change_product_quantity(product_name, quantity)",
        "get_cart_total()"
      ],
      "validations": [
        "verify_product_in_cart(product_name, quantity, subtotal)",
        "verify_cart_total(expected_total)",
        "verify_no_page_refresh_or_spinner()"
      ]
    }
  }
}