{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_03": {"by": "xpath", "value": "//div[@data-product='TD-03']"},
        "cart_item_td_01": {"by": "xpath", "value": "//div[@data-product='TD-01']"},
        "quantity_field": {"by": "xpath", "value": "//input[@class='quantity-input']"},
        "increment_button": {"by": "xpath", "value": "//button[@aria-label='Increment']"},
        "decrement_button": {"by": "xpath", "value": "//button[@aria-label='Decrement']"},
        "line_item_subtotal": {"by": "xpath", "value": "//span[@class='line-item-subtotal']"},
        "max_quantity_message": {"by": "xpath", "value": "//div[contains(text(),'Maximum available quantity reached')]"},
        "confirmation_message": {"by": "xpath", "value": "//div[contains(text(),'Quantity updated in cart')]"}
      },
      "actions": [
        "ensure_cart_contains(product_code, quantity, stock)",
        "increment_quantity(product_code)",
        "navigate_to_cart()"
      ],
      "validations": [
        "verify_cart_item(product_code, quantity)",
        "verify_increment_button_disabled(product_code)",
        "verify_max_quantity_message_displayed()",
        "verify_line_item_subtotal(product_code, expected_subtotal)",
        "verify_confirmation_message_displayed()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "add_to_cart_button_td_01": {"by": "xpath", "value": "//button[@data-product='TD-01' and contains(text(),'Add to Cart')]"}
      },
      "actions": [
        "navigate_to_product_catalog()",
        "add_to_cart(product_code)"
      ],
      "validations": []
    }
  }
}