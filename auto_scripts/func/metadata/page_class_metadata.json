{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "PLACEHOLDER", "value": "//row[contains(.,'Wireless Mouse')]"},
        "product_b_row": {"by": "PLACEHOLDER", "value": "//row[contains(.,'Coffee Subscription')]"},
        "add_product_button": {"by": "PLACEHOLDER", "value": "//button[contains(.,'Add to Cart')]"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "line_item_subtotal": {"by": "PLACEHOLDER", "value": "//span[@class='item-subtotal']"}
      },
      "actions": [
        "add_product(product_name, quantity)",
        "navigate_to_cart()",
        "change_quantity(product_name, quantity)"
      ],
      "validations": [
        "verify_product_in_cart(product_name, quantity, subtotal)",
        "verify_cart_total(expected_total)",
        "verify_no_refresh_or_spinner()"
      ]
    }
  }
}