{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "cart_item_td_01": {"by": "xpath", "value": "//div[@data-product='TD-01']"},
        "increment_button_td_01": {"by": "xpath", "value": "//div[@data-product='TD-01']//button[@aria-label='Increment']"},
        "delete_button_td_01": {"by": "xpath", "value": "//div[@data-product='TD-01']//button[@aria-label='Delete']"},
        "cart_item_td_02": {"by": "xpath", "value": "//div[@data-product='TD-02']"},
        "confirmation_message": {"by": "xpath", "value": "//div[contains(@class,'confirmation-message')]"},
        "cart_total": {"by": "xpath", "value": "//span[@id='cart-total']"},
        "line_item_subtotal": {"by": "xpath", "value": "//div[@data-product and .//span[contains(@class,'subtotal')]]"}
      },
      "actions": [
        "increment_quantity(product_code)",
        "delete_product(product_code)"
      ],
      "validations": [
        "verify_cart_contains(product_code, quantity, subtotal)",
        "verify_line_item_subtotal(product_code, expected_subtotal)",
        "verify_cart_total(expected_total)",
        "verify_confirmation_message(expected_message)",
        "verify_no_page_reload()"
      ]
    }
  }
}
