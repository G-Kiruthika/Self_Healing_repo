{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "//div[@data-product-id='{product_id}']"},
        "delete_button": {"by": "PLACEHOLDER", "value": "//button[@data-action='delete']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Your cart is empty')]"},
        "continue_shopping_button": {"by": "PLACEHOLDER", "value": "//button[text()='Continue Shopping']"},
        "checkout_button": {"by": "PLACEHOLDER", "value": "//button[text()='Checkout']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": "//input[@name='quantity']"},
        "inventory_error_message": {"by": "PLACEHOLDER", "value": "//div[contains(@class,'error') and contains(text(),'units available')]"},
        "suggestion_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Maximum available')]"}
      },
      "actions": [
        "delete_product(product_id)",
        "click_continue_shopping()",
        "update_quantity(product_id, quantity)"
      ],
      "validations": [
        "is_product_in_cart(product_id)",
        "is_cart_empty()",
        "is_empty_cart_message_displayed()",
        "is_continue_shopping_button_displayed()",
        "is_checkout_button_unavailable()",
        "is_inventory_error_displayed()",
        "is_quantity_equal(product_id, expected_quantity)",
        "is_suggestion_message_displayed()"
      ]
    },
    "ProductCatalogPage": {
      "file_name": "product_catalog_page.py",
      "locators": {
        "catalog_root": {"by": "PLACEHOLDER", "value": "//div[@id='product-catalog']"}
      },
      "actions": [
        "navigate_to()"
      ],
      "validations": [
        "is_catalog_displayed()"
      ]
    }
  }
}