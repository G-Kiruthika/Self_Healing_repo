{
  "pages": {
    "ProductListPage": {
      "file_name": "product_list_page.py",
      "locators": {
        "product_a_add_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='A']"},
        "product_b_add_button": {"by": "PLACEHOLDER", "value": "//button[@data-product='B']"},
        "cart_icon": {"by": "PLACEHOLDER", "value": "//a[@id='cart']"}
      },
      "actions": [
        "add_product(product_name, quantity)",
        "go_to_cart()"
      ],
      "validations": []
    },
    "ShoppingCartPage": {
      "file_name": "shopping_cart_page.py",
      "locators": {
        "product_row": {"by": "PLACEHOLDER", "value": "//tr[@data-product]"},
        "product_name": {"by": "PLACEHOLDER", "value": ".//td[@class='name']"},
        "unit_price": {"by": "PLACEHOLDER", "value": ".//td[@class='unit-price']"},
        "quantity_input": {"by": "PLACEHOLDER", "value": ".//input[@class='qty']"},
        "subtotal": {"by": "PLACEHOLDER", "value": ".//td[@class='subtotal']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "loading_spinner": {"by": "PLACEHOLDER", "value": "//div[@id='spinner']"}
      },
      "actions": [
        "update_quantity(product_name, quantity)"
      ],
      "validations": [
        "is_product_in_cart(product_name)",
        "verify_product_details(product_name, unit_price, quantity, subtotal)",
        "verify_cart_total(expected_total)",
        "is_loading_spinner_visible()"
      ]
    }
  }
}