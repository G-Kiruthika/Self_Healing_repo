{
  "pages": {
    "ExperianHomepage": {
      "file_name": "experian_homepage.py",
      "locators": {
        "hero_heading": {"by": "xpath", "value": "//h1[contains(text(), 'Reach your credit and money goals')]"},
        "credit_score_tab": {"by": "xpath", "value": "//button[contains(text(), 'Get a credit report & FICO Score')]"},
        "hero_tab_list": {"by": "xpath", "value": "//div[contains(@class, 'tablist')]"}
      },
      "actions": [
        "navigate_to_homepage()",
        "locate_hero_tab_list()"
      ],
      "validations": [
        "verify_url(expected_url)",
        "verify_title_contains(expected_title)",
        "is_hero_heading_visible()",
        "is_credit_score_tab_visible()"
      ]
    }
  }
}