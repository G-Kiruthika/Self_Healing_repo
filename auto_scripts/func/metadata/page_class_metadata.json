{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_item": {"by": "PLACEHOLDER", "value": "//div[@data-product='A']"},
        "product_c_item": {"by": "PLACEHOLDER", "value": "//div[@data-product='C']"},
        "delete_button_product_c": {"by": "PLACEHOLDER", "value": "//button[@data-action='delete'][@data-product='C']"},
        "cart_total": {"by": "PLACEHOLDER", "value": "//span[@id='cart-total']"},
        "empty_cart_message": {"by": "PLACEHOLDER", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "PLACEHOLDER", "value": "//button[contains(text(),'Return to Product Catalog')]"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, subtotal)",
        "click_delete_for_product(product_name)",
        "navigate_to_cart_page()"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_product_not_present(product_name)",
        "validate_cart_total(amount)",
        "validate_empty_cart_message_displayed()",
        "validate_return_to_catalog_button_displayed()"
      ]
    }
  }
}