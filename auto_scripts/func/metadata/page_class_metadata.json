{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_a_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Product A')]]"},
        "product_c_row": {"by": "xpath", "value": "//tr[td[contains(text(),'Product C')]]"},
        "delete_button_product_c": {"by": "xpath", "value": "//tr[td[contains(text(),'Product C')]]//button[contains(text(),'Delete')]"},
        "cart_total": {"by": "id", "value": "cart-total"},
        "empty_cart_message": {"by": "xpath", "value": "//div[contains(text(),'Your cart is empty')]"},
        "return_to_catalog_button": {"by": "xpath", "value": "//button[contains(text(),'Return to Product Catalog')]"}
      },
      "actions": [
        "delete_product(product_name)",
        "navigate_to_cart()"
      ],
      "validations": [
        "validate_product_present(product_name)",
        "validate_product_not_present(product_name)",
        "validate_cart_total(expected_total)",
        "validate_empty_cart_message()",
        "validate_return_to_catalog_button_present()"
      ]
    }
  }
}