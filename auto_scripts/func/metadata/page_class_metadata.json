{
  "pages": {
    "ExperianHomePage": {
      "file_name": "experian_home_page.py",
      "locators": {
        "header_navigation": {"by": "XPATH", "value": "//header//nav"},
        "credit_menu_button": {"by": "XPATH", "value": "//nav//a[contains(text(), 'Credit')]"},
        "protection_menu_button": {"by": "XPATH", "value": "//nav//a[contains(text(), 'Protection')]"}
      },
      "actions": [
        "navigate_to_homepage(url)",
        "locate_header_navigation()"
      ],
      "validations": [
        "is_credit_menu_button_visible()",
        "is_protection_menu_button_visible()"
      ]
    }
  }
}