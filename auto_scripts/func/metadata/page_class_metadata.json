{
  "pages": {
    "RequirementsAnalysisPage": {
      "file_name": "requirements_analysis_page.py",
      "locators": {
        "requirements_section": {"by": "ID", "value": "requirements-section"},
        "test_scenarios_list": {"by": "ID", "value": "test-scenarios-list"}
      },
      "actions": [
        "analyze_requirements()",
        "generate_test_scenarios()"
      ],
      "validations": [
        "validate_requirements_analyzed()",
        "validate_test_scenarios_generated()"
      ]
    },
    "TestRailPublishingPage": {
      "file_name": "test_rail_publishing_page.py",
      "locators": {
        "publish_button": {"by": "ID", "value": "publish-btn"},
        "formatting_status": {"by": "ID", "value": "formatting-status"}
      },
      "actions": [
        "publish_test_cases()"
      ],
      "validations": [
        "validate_test_cases_published()",
        "validate_formatting()"
      ]
    }
  }
}