{
  "pages": {
    "CartPage": {
      "file_name": "cart_page.py",
      "locators": {
        "product_c_row": {"by": "XPATH", "value": "//tr[.//text()='Laptop Stand']"},
        "product_b_row": {"by": "XPATH", "value": "//tr[.//text()='Coffee Subscription']"},
        "quantity_input": {"by": "CSS_SELECTOR", "value": ".cart-item-quantity-input"},
        "subtotal_field": {"by": "CSS_SELECTOR", "value": ".cart-item-subtotal"},
        "error_message": {"by": "CSS_SELECTOR", "value": ".error-message"}
      },
      "actions": [
        "ensure_product_in_cart(product_name, quantity)",
        "update_product_quantity(product_name, quantity)",
        "check_line_item_subtotal(product_name)",
        "attempt_reduce_quantity(product_name, quantity)",
        "get_quantity(product_name)"
      ],
      "validations": [
        "validate_product_in_cart(product_name)",
        "validate_quantity(product_name, expected_quantity)",
        "validate_subtotal(product_name, expected_subtotal)",
        "validate_no_inventory_error()",
        "validate_warning_message_displayed()"
      ]
    }
  }
}
