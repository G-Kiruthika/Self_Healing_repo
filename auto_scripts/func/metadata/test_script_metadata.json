        {"page": "ProductCatalogPage", "action": "search_product", "data_ref": "premium_coffee_beans"},
        {"page": "ProductCatalogPage", "action": "select_product", "data_ref": "TD-02"},
        {"page": "ProductCatalogPage", "assertion": "is_min_threshold_visible"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "TD-02"},
        {"page": "CartPage", "assertion": "is_cart_item_displayed"},
        {"page": "CartPage", "assertion": "is_min_threshold_indicator_displayed"}
      ],
      "test_data": {
        "user_john_doe": {
          "username": "john.doe",
          "password": "password123"
        },
        "premium_coffee_beans": {
          "product_name": "Premium Coffee Beans - 1kg",
          "product_code": "TD-02",
          "stock": 30,
          "min_threshold": 5
        }
      }
    },
    "1500": {
      "test_name": "test_add_organic_green_tea_subscription_to_cart",
