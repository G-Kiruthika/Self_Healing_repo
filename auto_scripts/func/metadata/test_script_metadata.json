        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_empty_message_displayed"}
      ],
      "test_data": {
        "product_1": {"product_name": "Wireless Mouse"}
      }
