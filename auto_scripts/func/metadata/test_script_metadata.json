{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "277": {
      "test_name": "test_login_and_add_subscription_product",
      "feature": "Subscription Product Management",
      "target_file": "test_subscription_product_management.py",
      "pages_used": ["LoginPage", "ProductPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "subscription_user"},
        {"page": "LoginPage", "assertion": "is_logged_in_as_subscriber"},
        {"page": "ProductPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse"},
        {"page": "ProductPage", "assertion": "is_product_added"},
        {"page": "ProductPage", "action": "increase_quantity", "data_ref": "subscription_quantity"},
        {"page": "ProductPage", "assertion": "is_quantity_increased"}
      ],
      "test_data": {
        "subscription_user": {
          "username": "subscriber1",
          "password": "password123"
        },
        "wireless_mouse": {
          "product_name": "Wireless Mouse"
        },
        "subscription_quantity": {
          "product_name": "Wireless Mouse",
          "amount": 2
        }
      }
    },
    "278": {
      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "Cart Management",
      "target_file": "test_cart_management.py",
      "pages_used": ["ProductPage", "CartPage"],
      "flow": [
        {"page": "ProductPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse"},
        {"page": "ProductPage", "action": "add_product_to_cart", "data_ref": "keyboard"},
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_displayed"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "cart_product_details"}
      ],
      "test_data": {
        "wireless_mouse": {
          "product_name": "Wireless Mouse"
        },
        "keyboard": {
          "product_name": "Keyboard"
        },
        "cart_product_details": {
          "products": [
            {"product_name": "Wireless Mouse", "unit_price": 20.0, "quantity": 1, "subtotal": 20.0},
            {"product_name": "Keyboard", "unit_price": 30.0, "quantity": 1, "subtotal": 30.0}
          ]
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
