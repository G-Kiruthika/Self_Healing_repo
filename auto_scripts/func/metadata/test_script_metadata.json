{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1501": {
      "test_name": "test_cart_increment_quantity",
      "feature": "Cart Functionality",
      "target_file": "test_cart_increment_quantity.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "TD-01_1_12.99"},
        {"page": "CartPage", "assertion": "validate_cart_item"},
        {"page": "CartPage", "action": "click_increment", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "validate_cart_item"},
        {"page": "CartPage", "assertion": "validate_cart_total"},
        {"page": "CartPage", "assertion": "validate_no_page_reload"}
      ],
      "test_data": {
        "TD-01_1_12.99": {"product_id": "TD-01", "quantity": 1, "subtotal": 12.99},
        "TD-01_2_25.98": {"product_id": "TD-01", "quantity": 2, "subtotal": 25.98},
        "cart_total": {"total": 25.98}
      }
    },
    "1502": {
      "test_name": "test_cart_delete_product",
      "feature": "Cart Functionality",
      "target_file": "test_cart_delete_product.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "TD-01_2_25.98_and_TD-02_5_124.95"},
        {"page": "CartPage", "assertion": "validate_cart_item"},
        {"page": "CartPage", "action": "click_delete", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "validate_cart_item"},
        {"page": "CartPage", "assertion": "validate_cart_total"},
        {"page": "CartPage", "assertion": "validate_confirmation_message"}
      ],
      "test_data": {
        "TD-01_2_25.98_and_TD-02_5_124.95": {
          "products": [
            {"product_id": "TD-01", "quantity": 2, "subtotal": 25.98},
            {"product_id": "TD-02", "quantity": 5, "subtotal": 124.95}
          ],
          "cart_total": 150.93
        },
        "TD-02_5_124.95": {"product_id": "TD-02", "quantity": 5, "subtotal": 124.95},
        "cart_total": {"total": 124.95},
        "confirmation_message": {"message": "Item removed from cart"}
      }
    }
  },
