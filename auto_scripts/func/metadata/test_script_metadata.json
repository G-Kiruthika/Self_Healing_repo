{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "290": {
      "test_name": "test_add_and_update_cart",
      "feature": "ShoppingCart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse_add"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "wireless_mouse_update"},
        {"page": "CartPage", "assertion": "is_cart_updated_instantly"}
      ],
      "test_data": {
        "wireless_mouse_add": {"product_name": "Wireless Mouse", "quantity": 1},
        "wireless_mouse_update": {"product_name": "Wireless Mouse", "quantity": 2}
      }
    },
    "291": {
      "test_name": "test_prevent_negative_quantity",
      "feature": "ShoppingCart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse_negative"},
        {"page": "CartPage", "assertion": "is_negative_quantity_prevented"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "wireless_mouse_negative"},
        {"page": "CartPage", "assertion": "is_quantity_unchanged"}
      ],
      "test_data": {
        "wireless_mouse_negative": {"product_name": "Wireless Mouse", "quantity": -1}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}