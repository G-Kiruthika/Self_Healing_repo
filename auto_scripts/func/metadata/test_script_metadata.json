{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1511": {
      "test_name": "test_cart_maximum_quantity_behavior",
      "feature": "Cart Quantity Control",
      "target_file": "test_cart_quantity_control.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "increment_action"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_increment_button_disabled"},
        {"page": "CartPage", "assertion": "verify_max_quantity_message_displayed"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"}
      ],
      "test_data": {
        "cart_setup": {"product_code": "TD-03", "quantity": 2, "stock": 3},
        "increment_action": {"product_code": "TD-03"},
        "verify_cart_item_quantity_1": {"product_code": "TD-03", "expected_quantity": 2},
        "verify_cart_item_quantity_2": {"product_code": "TD-03", "expected_quantity": 3},
        "verify_line_item_subtotal": {"product_code": "TD-03", "expected_subtotal": "$25.50"},
        "verify_max_quantity_message_displayed": {"product_code": "TD-03"}
      }
    },
    "1512": {
      "test_name": "test_add_to_cart_existing_item",
      "feature": "Cart Quantity Control",
      "target_file": "test_cart_quantity_control.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "add_to_cart_action"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"},
        {"page": "CartPage", "assertion": "verify_confirmation_message"}
      ],
      "test_data": {
        "cart_setup": {"product_code": "TD-01", "quantity": 2, "subtotal": "$25.98"},
        "add_to_cart_action": {"product_code": "TD-01"},
        "verify_cart_item_quantity": {"product_code": "TD-01", "expected_quantity": 3},
        "verify_line_item_subtotal": {"product_code": "TD-01", "expected_subtotal": "$38.97"},
        "verify_confirmation_message": {"expected_message": "Quantity updated in cart"}
      }
    }
  },
