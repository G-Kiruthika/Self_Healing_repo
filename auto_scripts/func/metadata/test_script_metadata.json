{
  "test_suite": "AddPrintDropdownTests",
  "test_cases": [
    {
      "id": "59",
      "description": "Verify the behavior when the user selects any value in the 'Copies' dropdown on the 'Add Print' screen.",
      "flow": [
        {"action": "install_and_launch_app", "page": "HpxAppPage"},
        {"action": "navigate_to_printer_details", "page": "PrinterDetailsPage"},
        {"action": "navigate_to_add_shortcuts", "page": "AddShortcutsPage"},
        {"action": "enable_print_destination_toggle", "page": "AddShortcutsPage"},
        {"action": "click_copies_dropdown", "page": "AddShortcutsPage"},
        {"action": "select_copies_value", "page": "AddShortcutsPage", "data": {"value": "<test_value>"}},
        {"action": "verify_screen", "page": "AddShortcutsPage"}
      ],
      "test_data": {
        "copies_values": ["1", "2", "3", "4", "5"]
      },
      "expected_results": [
        "The list of other values should be displayed in the 'Copies' dropdown.",
        "User should be able to select any desired value in 'Copies' dropdown.",
        "The selected value should be displayed in 'Copies' dropdown."
      ],
      "pages_used": ["HpxAppPage", "PrinterDetailsPage", "AddShortcutsPage"]
    },
    {
      "id": "60",
      "description": "Verify the behavior when the user selects any option in the 'Color' dropdown on the 'Add Print' screen.",
      "flow": [
        {"action": "install_and_launch_app", "page": "HpxAppPage"},
        {"action": "navigate_to_printer_details", "page": "PrinterDetailsPage"},
        {"action": "navigate_to_add_shortcuts", "page": "AddShortcutsPage"},
        {"action": "enable_print_destination_toggle", "page": "AddShortcutsPage"},
        {"action": "click_color_dropdown", "page": "AddShortcutsPage"},
        {"action": "select_color_option", "page": "AddShortcutsPage", "data": {"option": "<test_option>"}},
        {"action": "verify_screen", "page": "AddShortcutsPage"}
      ],
      "test_data": {
        "color_options": ["Black & White", "Color"]
      },
      "expected_results": [
        "The list of other options should be displayed in the 'Color' dropdown.",
        "User should be able to select any desired option in 'Color' dropdown.",
        "The selected option should be displayed in 'Color' dropdown."
      ],
      "pages_used": ["HpxAppPage", "PrinterDetailsPage", "AddShortcutsPage"]
    }
  ],
  "framework": {
    "ui_automation_dependencies": [
      "selenium",
      "pytest",
      "page_objects",
      "conftest.py in config/",
      "base_page.py in core/",
      "utils.py in utils/",
      "requirements.txt",
      "test_data.json in config/"
    ],
    "ecosystem_sync": [
      "config/",
      "utils/",
      "core/",
      "requirements.txt"
    ]
  }
}
