{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1495": {
      "test_name": "test_remove_product_and_validate_cart_empty",
      "feature": "ShoppingCart",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Wireless Mouse"}},
        {"page": "CartPage", "action": "delete_product", "data_ref": {"product_name": "Wireless Mouse"}},
        {"page": "CartPage", "assertion": "is_cart_empty", "data_ref": null},
        {"page": "CartPage", "assertion": "is_message_displayed", "data_ref": {"message": "Your cart is empty"}},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": {"expected_total": "$0.00"}}
      ],
      "test_data": {
        "cart_products": {
          "product_name": "Wireless Mouse",
          "quantity": 1
        }
      }
    },
    "1496": {
      "test_name": "test_multiple_products_and_totals",
      "feature": "ShoppingCart",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product A"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product B"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product A", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product B", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product C", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": {"expected_total": "$187.96"}}
      ],
      "test_data": {
        "cart_products": {
          "Product A": {"quantity": 2},
          "Product B": {"quantity": 3},
          "Product C": {"quantity": 1}
        },
        "overall_total": "$187.96"
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
