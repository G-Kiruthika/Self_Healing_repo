{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1509": {
      "test_name": "test_cart_negative_quantity_validation",
      "feature": "Cart Quantity Validation",
      "target_file": "test_cart_quantity_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_cart_item_quantity", "data_ref": {"sku": "TD-01", "expected_quantity": 2}},
        {"page": "CartPage", "action": "enter_quantity", "data_ref": {"value": -5}},
        {"page": "CartPage", "action": "click_update_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_error_message", "data_ref": {"expected_message": "Quantity must be a positive number"}},
        {"page": "CartPage", "assertion": "validate_cart_item_quantity", "data_ref": {"sku": "TD-01", "expected_quantity": 2}},
        {"page": "CartPage", "assertion": "validate_cart_totals", "data_ref": {"expected_totals": "unchanged"}}
      ],
      "test_data": {
        "initial_cart": {"sku": "TD-01", "quantity": 2},
        "invalid_quantity": -5,
        "expected_error": "Quantity must be a positive number"
      }
    },
    "1510": {
      "test_name": "test_cart_minimum_threshold_buttons",
      "feature": "Cart Button Enablement",
      "target_file": "test_cart_button_enablement.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_cart_item_quantity", "data_ref": {"sku": "TD-02", "expected_quantity": 5}},
        {"page": "CartPage", "assertion": "validate_button_enabled", "data_ref": {"button_name": "decrement", "expected_enabled": false}},
        {"page": "CartPage", "assertion": "validate_button_enabled", "data_ref": {"button_name": "increment", "expected_enabled": true}},
        {"page": "CartPage", "assertion": "validate_line_item_subtotal", "data_ref": {"sku": "TD-02", "expected_subtotal": 124.95}},
        {"page": "CartPage", "assertion": "validate_threshold_indicator", "data_ref": {"sku": "TD-02", "expected_indicator": "Min: 5 units"}}
      ],
      "test_data": {
        "initial_cart": {"sku": "TD-02", "quantity": 5, "min_threshold": 5},
        "expected_subtotal": 124.95,
        "expected_indicator": "Min: 5 units"
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
