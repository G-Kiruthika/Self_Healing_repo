      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_products_in_cart", "data_ref": "TD-01, TD-02"},
        {"page": "CartPage", "assertion": "verify_product_fields", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "verify_product_fields", "data_ref": "TD-02"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "$150.93"}
      ],
      "test_data": {
        "TD-01": {
          "product_name": "TD-01",
          "unit_price": null,
          "quantity": null,
          "subtotal": null
        },
        "TD-02": {
          "product_name": "TD-02",
          "unit_price": null,
          "quantity": null,
          "subtotal": null
        },
        "expected_total": "$150.93"
      }
    },
    "1508": {
      "test_name": "test_cart_quantity_update_and_success_message",
      "feature": "ShoppingCart",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "action": "enter_quantity", "data_ref": "10"},
        {"page": "CartPage", "action": "click_update_button", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_product_fields", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "$129.90"},
        {"page": "CartPage", "assertion": "verify_success_message", "data_ref": "Quantity updated"}
      ],
      "test_data": {
        "TD-01": {
          "product_name": "TD-01",
          "initial_quantity": 1,
          "stock": 50,
          "updated_quantity": 10,
          "subtotal": "$129.90"
        },
        "expected_total": "$129.90",
        "success_message": "Quantity updated"
      }
    }
  },
