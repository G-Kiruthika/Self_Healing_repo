{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1489": {
      "test_name": "test_remove_product_and_verify_cart_total",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": {"product_name": "A", "subtotal": 25.00}},
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": {"product_name": "C", "subtotal": 89.99}},
        {"page": "CartPage", "action": "click_delete_for_product", "data_ref": {"product_name": "C"}},
        {"page": "CartPage", "action": "navigate_to_cart_page", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_product_present", "data_ref": {"product_name": "A"}},
        {"page": "CartPage", "assertion": "verify_product_not_present", "data_ref": {"product_name": "C"}},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": 25.00}}
      ],
      "test_data": {
        "cart_products": [
          {"product_name": "A", "subtotal": 25.00},
          {"product_name": "C", "subtotal": 89.99}
        ],
        "expected_total": 25.00
      }
    },
    "1490": {
      "test_name": "test_empty_cart_shows_message_and_no_items",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_empty", "data_ref": null},
        {"page": "CartPage", "action": "navigate_to_cart_page", "data_ref": null},
        {"page": "CartPage", "action": "observe_cart_page", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_empty_cart_message_displayed", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_no_product_line_items", "data_ref": null}
      ],
      "test_data": {
        "cart_products": [],
        "expected_message": "Your cart is empty"
      }
    }
  },
