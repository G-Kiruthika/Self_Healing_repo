{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1499": {
      "test_name": "test_add_minimum_threshold_product_to_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login_as_user", "data_ref": "user_john_doe"},
        {"page": "CartPage", "assertion": "validate_user_logged_in"},
        {"page": "ProductCatalogPage", "action": "search_product", "data_ref": "product_td_02"},
        {"page": "ProductCatalogPage", "assertion": "validate_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "validate_min_threshold_indicator"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "product_td_02"},
        {"page": "CartPage", "assertion": "validate_cart_item_details"},
        {"page": "CartPage", "assertion": "validate_min_threshold_in_cart"}
      ],
      "test_data": {
        "user_john_doe": {
          "username": "John Doe",
          "password": "<password>"
        },
        "product_td_02": {
          "product_id": "TD-02",
          "name": "Premium Coffee Beans - 1kg",
          "stock": 30,
          "min_threshold": 5
        },
        "expected_cart_details": {
          "product_id": "TD-02",
          "quantity": 5,
          "show_min_threshold": true
        }
      }
    },
    "1500": {
      "test_name": "test_add_subscription_product_to_cart",
      "feature": "SubscriptionCart",
      "target_file": "test_subscription_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login_with_subscription", "data_ref": "user_john_doe_premium"},
        {"page": "LoginPage", "assertion": "validate_subscription_badge"},
        {"page": "ProductCatalogPage", "action": "search_product", "data_ref": "product_td_01"},
        {"page": "ProductCatalogPage", "assertion": "validate_product_visible"},
        {"page": "ProductCatalogPage", "action": "select_subscription_option", "data_ref": "product_td_01"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "product_td_01"},
        {"page": "CartPage", "assertion": "validate_cart_item_details"},
        {"page": "CartPage", "assertion": "validate_subscription_badge_in_cart"},
        {"page": "CartPage", "assertion": "validate_subscription_pricing_and_frequency"}
      ],
      "test_data": {
        "user_john_doe_premium": {
          "username": "John Doe",
          "password": "<password>",
          "subscription_type": "Premium"
        },
        "product_td_01": {
          "product_id": "TD-01",
          "name": "Organic Green Tea - 100g",
          "supports_subscription": true
        },
        "expected_cart_details": {
          "product_id": "TD-01",
          "subscription": true,
          "show_subscription_badge": true
        }
      }
    }
  },
