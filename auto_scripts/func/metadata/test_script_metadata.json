{
  "test_suite": "AddEmailScreenTests",
  "test_cases": [
    {
      "test_case_id": "68",
      "description": "Verify the 'To' section when the user enters more than 20 email address in the 'Add Email' screen.",
      "flow": [
        {"action": "launch_app", "page": "HpxAppPage"},
        {"action": "navigate_to_printer_details", "page": "PrinterDetailsPage"},
        {"action": "navigate_to_add_shortcuts", "page": "AddShortcutsPage"},
        {"action": "enable_email_destination_toggle", "page": "AddShortcutsPage"},
        {"action": "click_continue_button", "page": "AddShortcutsPage"},
        {"action": "enter_to_section_emails", "page": "AddEmailPage", "data": {"emails_count": ">20"}},
        {"action": "click_add_to_shortcut_button", "page": "AddEmailPage"},
        {"action": "verify_error_message_displayed", "page": "AddEmailPage"}
      ],
      "test_data": {
        "emails_count": ">20"
      }
    },
    {
      "test_case_id": "69",
      "description": "Verify the 'Body' section of the 'Add Email' screen when the user modifies text.",
      "flow": [
        {"action": "launch_app", "page": "HpxAppPage"},
        {"action": "navigate_to_printer_details", "page": "PrinterDetailsPage"},
        {"action": "navigate_to_add_shortcuts", "page": "AddShortcutsPage"},
        {"action": "enable_email_destination_toggle", "page": "AddShortcutsPage"},
        {"action": "click_continue_button", "page": "AddShortcutsPage"},
        {"action": "modify_body_section_text", "page": "AddEmailPage", "data": {"body_text": "<modified>"}},
        {"action": "click_add_to_shortcut_button", "page": "AddEmailPage"},
        {"action": "verify_body_section_modification", "page": "AddEmailPage"}
      ],
      "test_data": {
        "body_text": "<modified>"
      }
    }
  ],
  "framework": {
    "dependencies": [
      "selenium",
      "pytest"
    ],
    "metadata_folder": "auto_scripts/func/metadata"
  }
}
