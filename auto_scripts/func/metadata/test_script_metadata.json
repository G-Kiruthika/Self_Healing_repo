{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1505": {
      "test_name": "test_product_out_of_stock_add_to_cart",
      "feature": "Product Out Of Stock",
      "target_file": "test_product_out_of_stock.py",
      "pages_used": ["ProductPage", "CartPage"],
      "flow": [
        {"page": "ProductPage", "action": "view_product", "data_ref": {"product_id": "TD-04"}},
        {"page": "ProductPage", "assertion": "is_out_of_stock_displayed"},
        {"page": "ProductPage", "action": "click_add_to_cart", "data_ref": null},
        {"page": "ProductPage", "assertion": "is_add_to_cart_disabled"},
        {"page": "ProductPage", "assertion": "is_error_message_displayed"},
        {"page": "CartPage", "assertion": "is_cart_item_present", "data_ref": {"product_id": "TD-04", "present": false}}
      ],
      "test_data": {
        "default": {
          "product_id": "TD-04",
          "stock": 0
        }
      }
    },
    "1506": {
      "test_name": "test_cart_quantity_minimum_threshold",
      "feature": "Cart Minimum Quantity",
      "target_file": "test_cart_quantity_minimum.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_product_quantity", "data_ref": {"product_id": "TD-02", "quantity": 5}},
        {"page": "CartPage", "assertion": "is_cart_item_present", "data_ref": {"product_id": "TD-02"}},
        {"page": "CartPage", "action": "click_decrement_button", "data_ref": {"product_id": "TD-02"}},
        {"page": "CartPage", "assertion": "is_validation_error_displayed"},
        {"page": "CartPage", "assertion": "is_quantity_displayed", "data_ref": {"product_id": "TD-02", "quantity": 5}},
        {"page": "CartPage", "assertion": "is_decrement_disabled", "data_ref": {"product_id": "TD-02"}}
      ],
      "test_data": {
        "default": {
          "product_id": "TD-02",
          "quantity": 5,
          "min_threshold": 5
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
