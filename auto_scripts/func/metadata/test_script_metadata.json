{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1505": {
      "test_name": "test_product_out_of_stock",
      "feature": "ProductStock",
      "target_file": "test_product_out_of_stock.py",
      "pages_used": ["ProductPage"],
      "flow": [
        {"page": "ProductPage", "action": "view_product", "data_ref": "product_TD-04"},
        {"page": "ProductPage", "assertion": "is_out_of_stock_displayed"},
        {"page": "ProductPage", "action": "click_add_to_cart", "data_ref": null},
        {"page": "ProductPage", "assertion": "is_add_to_cart_disabled"},
        {"page": "ProductPage", "assertion": "is_error_message_displayed", "data_ref": "out_of_stock_message"},
        {"page": "ProductPage", "assertion": "is_cart_unchanged"}
      ],
      "test_data": {
        "product_TD-04": {"product_code": "TD-04", "stock": 0},
        "out_of_stock_message": {"expected_message": "This product is currently out of stock"}
      }
    },
    "1506": {
      "test_name": "test_cart_minimum_quantity_validation",
      "feature": "CartMinimumQuantity",
      "target_file": "test_cart_minimum_quantity_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_product_displayed", "data_ref": "cart_TD-02"},
        {"page": "CartPage", "action": "click_decrement", "data_ref": "cart_TD-02"},
        {"page": "CartPage", "assertion": "is_validation_error_displayed", "data_ref": "min_quantity_message"},
        {"page": "CartPage", "assertion": "is_quantity_unchanged", "data_ref": "cart_TD-02"},
        {"page": "CartPage", "assertion": "is_decrement_disabled", "data_ref": "cart_TD-02"}
      ],
      "test_data": {
        "cart_TD-02": {"product_code": "TD-02", "quantity": 5, "minimum_threshold": 5},
        "min_quantity_message": {"expected_message": "Minimum order quantity is 5 units"}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
