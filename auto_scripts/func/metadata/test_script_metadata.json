{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1493": {
      "test_name": "test_update_product_c_quantity_to_max_stock",
      "feature": "CartQuantityAndSubtotal",
      "target_file": "test_cart_quantity_and_subtotal.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_c_initial"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "product_c_update"},
        {"page": "CartPage", "action": "check_line_item_subtotal", "data_ref": "product_c_update"},
        {"page": "CartPage", "assertion": "validate_product_present", "data_ref": "product_c_initial"},
        {"page": "CartPage", "assertion": "validate_quantity_updated", "data_ref": "product_c_update"},
        {"page": "CartPage", "assertion": "validate_subtotal", "data_ref": "product_c_expected"},
        {"page": "CartPage", "assertion": "validate_no_inventory_error", "data_ref": null}
      ],
      "test_data": {
        "product_c_initial": {"product_name": "Laptop Stand", "quantity": 1, "stock": 5},
        "product_c_update": {"product_name": "Laptop Stand", "quantity": 5},
        "product_c_expected": {"product_name": "Laptop Stand", "expected_subtotal": "$449.95"}
      }
    },
    "1494": {
      "test_name": "test_prevent_reducing_product_b_below_minimum_threshold",
      "feature": "CartQuantityThreshold",
      "target_file": "test_cart_quantity_threshold.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_b_initial"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "product_b_reduce"},
        {"page": "CartPage", "assertion": "validate_product_present", "data_ref": "product_b_initial"},
        {"page": "CartPage", "assertion": "validate_warning_message_displayed", "data_ref": null},
        {"page": "CartPage", "action": "check_line_item_subtotal", "data_ref": "product_b_initial"},
        {"page": "CartPage", "assertion": "validate_quantity_at_minimum", "data_ref": "product_b_minimum"}
      ],
      "test_data": {
        "product_b_initial": {"product_name": "Coffee Subscription", "quantity": 3, "minimum_threshold": 3},
        "product_b_reduce": {"product_name": "Coffee Subscription", "quantity": 1},
        "product_b_minimum": {"product_name": "Coffee Subscription", "min_quantity": 3}
      }
    }
  },
