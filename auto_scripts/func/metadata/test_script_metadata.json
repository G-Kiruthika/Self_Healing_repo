{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1493": {
      "test_name": "test_update_cart_quantity_and_validate_subtotal",
      "feature": "CartManagement",
      "target_file": "test_cart_management.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_c_initial"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "product_c_update"},
        {"page": "CartPage", "action": "get_line_item_subtotal", "data_ref": "product_c_update"},
        {"page": "CartPage", "assertion": "validate_product_in_cart", "data_ref": "product_c_update"},
        {"page": "CartPage", "assertion": "validate_line_item_subtotal", "data_ref": "product_c_expected_subtotal"},
        {"page": "CartPage", "assertion": "validate_no_inventory_error"}
      ],
      "test_data": {
        "product_c_initial": {"product_name": "Laptop Stand", "quantity": 1, "available_stock": 5},
        "product_c_update": {"product_name": "Laptop Stand", "quantity": 5},
        "product_c_expected_subtotal": {"product_name": "Laptop Stand", "expected_subtotal": "$449.95"}
      }
    },
    "1494": {
      "test_name": "test_prevent_reducing_below_minimum_quantity",
      "feature": "CartManagement",
      "target_file": "test_cart_management.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_b_initial"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "product_b_update"},
        {"page": "CartPage", "action": "get_warning_message", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_product_in_cart", "data_ref": "product_b_min_threshold"},
        {"page": "CartPage", "assertion": "validate_warning_message", "data_ref": "expected_warning"}
      ],
      "test_data": {
        "product_b_initial": {"product_name": "Coffee Subscription", "quantity": 3, "min_threshold": 3},
        "product_b_update": {"product_name": "Coffee Subscription", "quantity": 1},
        "product_b_min_threshold": {"product_name": "Coffee Subscription", "quantity": 3},
        "expected_warning": {"expected_message": "Minimum quantity for Coffee Subscription is 3."}
      }
    }
  },
