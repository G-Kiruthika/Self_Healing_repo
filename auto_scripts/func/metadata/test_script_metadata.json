{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1505": {
      "test_name": "test_product_out_of_stock_add_to_cart",
      "feature": "ProductStock",
      "target_file": "test_product_out_of_stock_add_to_cart.py",
      "pages_used": ["ProductPage"],
      "flow": [
        {"page": "ProductPage", "action": "view_product", "data_ref": "product_TD_04"},
        {"page": "ProductPage", "assertion": "is_out_of_stock_displayed"},
        {"page": "ProductPage", "action": "click_add_to_cart", "data_ref": null},
        {"page": "ProductPage", "assertion": "is_add_to_cart_disabled"},
        {"page": "ProductPage", "assertion": "is_error_message_displayed", "data_ref": "out_of_stock_message"},
        {"page": "ProductPage", "assertion": "is_cart_unchanged"}
      ],
      "test_data": {
        "product_TD_04": {
          "product_code": "TD-04",
          "stock": 0
        },
        "out_of_stock_message": {
          "expected_message": "This product is currently out of stock"
        }
      }
    },
    "1506": {
      "test_name": "test_cart_minimum_order_quantity_decrement",
      "feature": "CartQuantityValidation",
      "target_file": "test_cart_minimum_order_quantity_decrement.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "cart_product_TD_02"},
        {"page": "CartPage", "action": "click_decrement", "data_ref": "cart_product_TD_02"},
        {"page": "CartPage", "assertion": "is_validation_error_displayed", "data_ref": "min_order_error"},
        {"page": "CartPage", "assertion": "is_quantity_unchanged", "data_ref": "cart_product_TD_02"},
        {"page": "CartPage", "assertion": "is_decrement_disabled", "data_ref": "cart_product_TD_02"}
      ],
      "test_data": {
        "cart_product_TD_02": {
          "product_code": "TD-02",
          "quantity": 5,
          "min_threshold": 5
        },
        "min_order_error": {
          "expected_message": "Minimum order quantity is 5 units"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}