{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1493": {
      "test_name": "test_cart_update_quantity_laptop_stand",
      "feature": "Cart",
      "target_file": "test_cart_update_quantity_laptop_stand.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "laptop_stand_in_cart"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "laptop_stand_update_quantity"},
        {"page": "CartPage", "action": "get_line_item_subtotal", "data_ref": "laptop_stand_subtotal"},
        {"page": "CartPage", "assertion": "validate_product_present"},
        {"page": "CartPage", "assertion": "validate_quantity"},
        {"page": "CartPage", "assertion": "validate_line_item_subtotal"},
        {"page": "CartPage", "assertion": "validate_no_inventory_error"}
      ],
      "test_data": {
        "laptop_stand_in_cart": {
          "product_name": "Laptop Stand",
          "quantity": 1,
          "available_stock": 5
        },
        "laptop_stand_update_quantity": {
          "product_name": "Laptop Stand",
          "quantity": 5
        },
        "laptop_stand_subtotal": {
          "product_name": "Laptop Stand",
          "expected_subtotal": 449.95
        }
      }
    },
    "1494": {
      "test_name": "test_cart_minimum_threshold_coffee_subscription",
