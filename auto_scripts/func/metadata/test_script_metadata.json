{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1493": {
      "test_name": "test_update_product_c_quantity_and_check_subtotal",
      "feature": "CartFunctionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_c_initial"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "product_c_update"},
        {"page": "CartPage", "action": "check_line_item_subtotal", "data_ref": "product_c_update"},
        {"page": "CartPage", "action": "check_error_messages", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_product_in_cart"},
        {"page": "CartPage", "assertion": "validate_subtotal"},
        {"page": "CartPage", "assertion": "validate_no_inventory_error"}
      ],
      "test_data": {
        "product_c_initial": {
          "product_name": "Laptop Stand",
          "quantity": 1,
          "stock": 5
        },
        "product_c_update": {
          "product_name": "Laptop Stand",
          "quantity": 5,
          "expected_subtotal": "$449.95"
        }
      }
    },
    "1494": {
      "test_name": "test_reduce_product_b_quantity_below_minimum_threshold",
      "feature": "CartFunctionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_b_initial"},
        {"page": "CartPage", "action": "attempt_reduce_quantity", "data_ref": "product_b_reduce"},
        {"page": "CartPage", "action": "check_cart_quantity", "data_ref": "product_b_initial"},
        {"page": "CartPage", "action": "check_error_messages", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_product_in_cart"},
        {"page": "CartPage", "assertion": "validate_quantity_threshold"},
        {"page": "CartPage", "assertion": "validate_warning_message"}
      ],
      "test_data": {
        "product_b_initial": {
          "product_name": "Coffee Subscription",
          "quantity": 3,
          "min_threshold": 3
        },
        "product_b_reduce": {
          "product_name": "Coffee Subscription",
          "quantity": 1
        }
      }
    }
  },
