        {"page": "ProductCatalogPage", "assertion": "is_subscription_supported"},
        {"page": "ProductCatalogPage", "action": "select_subscription_option", "data_ref": "TD-01"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "is_cart_item_displayed"},
        {"page": "CartPage", "assertion": "is_subscription_badge_displayed"},
        {"page": "CartPage", "assertion": "is_delivery_frequency_option_displayed"}
