{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1509": {
      "test_name": "test_cart_quantity_negative_value",
      "feature": "Cart Quantity Validation",
      "target_file": "test_cart_quantity_negative_value.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "get_cart_item_quantity", "data_ref": "product_1"},
        {"page": "CartPage", "action": "enter_quantity", "data_ref": "negative_quantity"},
        {"page": "CartPage", "action": "click_update_button", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_error_message", "data_ref": "negative_quantity_error"},
        {"page": "CartPage", "assertion": "validate_cart_item_quantity", "data_ref": "product_1"},
        {"page": "CartPage", "assertion": "validate_cart_totals", "data_ref": "initial_totals"}
      ],
      "test_data": {
        "product_1": {
          "product_code": "TD-01",
          "quantity": 2
        },
        "negative_quantity": {
          "product_code": "TD-01",
          "quantity": -5
        },
        "negative_quantity_error": {
          "expected_message": "Quantity must be a positive number"
        },
        "initial_totals": {
          "expected_totals": "unchanged"
        }
      }
    },
    "1510": {
      "test_name": "test_cart_minimum_quantity_threshold",
      "feature": "Cart Quantity Threshold",
      "target_file": "test_cart_minimum_quantity_threshold.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "get_cart_item_quantity", "data_ref": "product_2"},
        {"page": "CartPage", "assertion": "validate_button_enabled", "data_ref": "decrement_disabled"},
        {"page": "CartPage", "assertion": "validate_button_enabled", "data_ref": "increment_enabled"},
        {"page": "CartPage", "assertion": "validate_line_item_subtotal", "data_ref": "product_2_subtotal"},
        {"page": "CartPage", "assertion": "validate_threshold_indicator", "data_ref": "product_2_threshold"}
      ],
      "test_data": {
        "product_2": {
          "product_code": "TD-02",
          "quantity": 5,
          "min_threshold": 5
        },
        "decrement_disabled": {
          "button_name": "decrement_button",
          "expected": false
        },
        "increment_enabled": {
          "button_name": "increment_button",
          "expected": true
        },
        "product_2_subtotal": {
          "product_code": "TD-02",
          "expected_subtotal": "$124.95"
        },
        "product_2_threshold": {
          "product_code": "TD-02",
          "expected_indicator": "Min: 5 units"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
