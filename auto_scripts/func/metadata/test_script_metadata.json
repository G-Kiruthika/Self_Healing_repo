      "test_name": "test_cart_add_multiple_products",
      "feature": "Cart",
      "target_file": "test_cart_add_multiple_products.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "empty_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "product_1"},
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "product_2"},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "product_1"},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "product_2"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_1_details"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_2_details"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "expected_total"}
      ],
      "test_data": {
        "product_1": {"product_name": "Wireless Mouse"},
        "product_2": {"product_name": "Keyboard"},
        "product_1_details": {"product_name": "Wireless Mouse", "unit_price": "auto", "quantity": 1, "subtotal": "auto"},
        "product_2_details": {"product_name": "Keyboard", "unit_price": "auto", "quantity": 1, "subtotal": "auto"},
        "expected_total": {"total": "auto"}
      }
    },
    "286": {
