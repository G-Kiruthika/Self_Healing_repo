{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "290": {
      "test_name": "test_add_and_update_cart",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse_positive"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "update_or_remove"},
        {"page": "CartPage", "assertion": "is_cart_updated_instantly"},
        {"page": "CartPage", "assertion": "is_product_in_cart"}
      ],
      "test_data": {
        "wireless_mouse_positive": {"product_name": "Wireless Mouse", "quantity": 1},
        "update_or_remove": {"product_name": "Wireless Mouse", "quantity": 0}
      }
    },
    "291": {
      "test_name": "test_add_negative_quantity_cart",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse_negative"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "negative_quantity"},
        {"page": "CartPage", "assertion": "is_no_negative_quantity_in_cart"}
      ],
      "test_data": {
        "wireless_mouse_negative": {"product_name": "Wireless Mouse", "quantity": -1},
        "negative_quantity": {"product_name": "Wireless Mouse", "quantity": -1}
      }
    }
  },
