{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1491": {
      "test_name": "test_cart_product_quantity_inventory_validation",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "product_c_initial"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "product_c_update"},
        {"page": "CartPage", "assertion": "is_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "assertion": "is_cart_total_correct"}
      ],
      "test_data": {
        "product_c_initial": {
          "product_name": "Laptop Stand",
          "expected_qty": 2,
          "expected_stock": 5
        },
        "product_c_update": {
          "product_name": "Laptop Stand",
          "quantity": 10
        }
      }
    },
    "1492": {
      "test_name": "test_product_catalog_add_out_of_stock_inventory_validation",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": ["ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_stock_information_displayed"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_e_add"},
        {"page": "ProductCatalogPage", "assertion": "is_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "is_product_in_cart"}
      ],
      "test_data": {
        "product_e_add": {
          "product_name": "USB Cable"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
