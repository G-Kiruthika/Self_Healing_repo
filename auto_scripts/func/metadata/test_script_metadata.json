{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1485": {
      "test_name": "test_add_subscription_product_to_cart",
      "feature": "Product Subscription Cart",
      "target_file": "test_product_subscription_cart.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_credentials"},
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "vitamin_pack"},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "vitamin_pack"},
        {"page": "CartPage", "assertion": "is_subscription_indicator_displayed", "data_ref": "vitamin_pack"},
        {"page": "CartPage", "assertion": "verify_product_subtotal", "data_ref": "vitamin_pack_subtotal"}
      ],
      "test_data": {
        "user_credentials": {"username": "customer", "password": "customer_password"},
        "vitamin_pack": {"product_name": "Vitamin Pack", "min_quantity": 2},
        "vitamin_pack_subtotal": {"product_name": "Vitamin Pack", "expected_subtotal": "$91.00"}
      }
    },
    "1488": {
      "test_name": "test_update_subscription_quantity_and_verify_totals",
      "feature": "Product Subscription Cart",
      "target_file": "test_product_subscription_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "vitamin_pack"},
        {"page": "CartPage", "action": "set_product_quantity", "data_ref": "update_quantity"},
        {"page": "CartPage", "assertion": "verify_product_subtotal", "data_ref": "updated_vitamin_pack_subtotal"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "updated_cart_total"}
      ],
      "test_data": {
        "vitamin_pack": {"product_name": "Vitamin Pack", "quantity": 2, "subtotal": "$91.00"},
        "update_quantity": {"product_name": "Vitamin Pack", "quantity": 6},
        "updated_vitamin_pack_subtotal": {"product_name": "Vitamin Pack", "expected_subtotal": "$273.00"},
        "updated_cart_total": {"expected_total": "$273.00"}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
