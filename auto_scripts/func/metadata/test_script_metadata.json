        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "assertion": "is_quantity_set", "data_ref": {"product_name": "Wireless Mouse", "quantity": 3}}
      ],
      "test_data": {
        "wireless_mouse": {
          "product_name": "Wireless Mouse",
          "quantity": 3
        }
      }
    },
