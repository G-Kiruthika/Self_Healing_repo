{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1483": {
      "test_name": "test_add_product_a_to_cart",
      "feature": "Add Product A to Cart",
      "target_file": "test_add_product_a_to_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "login_data"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "login_data"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "LoginPage", "assertion": "is_logged_in"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_a"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_icon_updated"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "login_data": {
          "username": "customer_user",
          "password": "password123"
        },
        "product_a": {
          "product_name": "Wireless Mouse",
          "expected_subtotal": "$25.00",
          "expected_cart_count": 1
        }
      }
    },
    "1484": {
      "test_name": "test_add_product_b_with_minimum_threshold_to_cart",
      "feature": "Add Product B with Minimum Threshold to Cart",
      "target_file": "test_add_product_b_with_minimum_threshold_to_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "login_data"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "login_data"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "LoginPage", "assertion": "is_logged_in"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_b"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_minimum_threshold_displayed"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "product_b"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_icon_updated"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "login_data": {
          "username": "customer_user",
          "password": "password123"
        },
        "product_b": {
          "product_name": "Coffee Subscription",
          "expected_subtotal": "$47.97",
          "expected_cart_count": 3,
          "minimum_threshold": 3
        }
      }
    }
  },
