{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1511": {
      "test_name": "test_cart_max_quantity_td_03",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "td_03_cart_setup"},
        {"page": "CartPage", "assertion": "verify_cart_item"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "td_03_cart_increment"},
        {"page": "CartPage", "assertion": "verify_cart_item"},
        {"page": "CartPage", "assertion": "verify_increment_button_disabled"},
        {"page": "CartPage", "assertion": "verify_max_quantity_message_displayed"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"}
      ],
      "test_data": {
        "td_03_cart_setup": {"product_code": "TD-03", "quantity": 2, "stock": 3},
        "td_03_cart_increment": {"product_code": "TD-03", "increment": 1},
        "expected_subtotal": 25.50
      }
    },
    "1512": {
      "test_name": "test_cart_add_to_existing_td_01",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "td_01_cart_setup"},
        {"page": "CartPage", "assertion": "verify_cart_item"},
        {"page": "ProductCatalogPage", "action": "navigate_to_product_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "td_01_product_add"},
        {"page": "CartPage", "assertion": "verify_cart_item"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"},
        {"page": "CartPage", "assertion": "verify_confirmation_message_displayed"}
      ],
      "test_data": {
        "td_01_cart_setup": {"product_code": "TD-01", "quantity": 2, "subtotal": 25.98},
        "td_01_product_add": {"product_code": "TD-01"},
        "expected_subtotal": 38.97
      }
    }
  },
