        {"page": "CartPage", "assertion": "verify_cart_details"},
        {"page": "CartPage", "assertion": "verify_min_threshold_indicator"}
      ],
      "test_data": {
        "user_john_doe": {
          "username": "John Doe",
          "password": "<password>"
        },
        "product_td_02": {
          "product_code": "TD-02",
