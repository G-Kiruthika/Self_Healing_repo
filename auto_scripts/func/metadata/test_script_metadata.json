{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1493": {
      "test_name": "test_update_product_c_quantity_to_max",
      "feature": "CartQuantityUpdate",
      "target_file": "test_cart_quantity_update.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_c_initial"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "product_c_max"},
        {"page": "CartPage", "action": "check_line_item_subtotal", "data_ref": "product_c_max"},
        {"page": "CartPage", "assertion": "validate_product_in_cart", "data_ref": "product_c_max"},
        {"page": "CartPage", "assertion": "validate_quantity", "data_ref": "product_c_max"},
        {"page": "CartPage", "assertion": "validate_subtotal", "data_ref": "product_c_subtotal"},
        {"page": "CartPage", "assertion": "validate_no_inventory_error", "data_ref": null}
      ],
      "test_data": {
        "product_c_initial": {"product_name": "Laptop Stand", "quantity": 1, "available_stock": 5},
        "product_c_max": {"product_name": "Laptop Stand", "quantity": 5},
        "product_c_subtotal": {"product_name": "Laptop Stand", "expected_subtotal": "$449.95"}
      }
    },
    "1494": {
      "test_name": "test_prevent_reducing_below_minimum_threshold",
      "feature": "CartQuantityValidation",
      "target_file": "test_cart_quantity_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_b_initial"},
        {"page": "CartPage", "action": "attempt_reduce_quantity", "data_ref": "product_b_reduce"},
        {"page": "CartPage", "action": "get_quantity", "data_ref": "product_b_after_attempt"},
        {"page": "CartPage", "assertion": "validate_product_in_cart", "data_ref": "product_b_initial"},
        {"page": "CartPage", "assertion": "validate_quantity", "data_ref": "product_b_min_threshold"},
        {"page": "CartPage", "assertion": "validate_warning_message_displayed", "data_ref": null}
      ],
      "test_data": {
        "product_b_initial": {"product_name": "Coffee Subscription", "quantity": 3, "min_threshold": 3},
        "product_b_reduce": {"product_name": "Coffee Subscription", "quantity": 1},
        "product_b_after_attempt": {"product_name": "Coffee Subscription"},
        "product_b_min_threshold": {"product_name": "Coffee Subscription", "expected_quantity": 3}
      }
    }
  },
