{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1505": {
      "test_name": "test_out_of_stock_product_behavior",
      "feature": "Product Stock Validation",
      "target_file": "test_product_out_of_stock.py",
      "pages_used": ["ProductPage", "CartPage"],
      "flow": [
        {"page": "ProductPage", "action": "view_product", "data_ref": "TD-04"},
        {"page": "ProductPage", "assertion": "is_out_of_stock_displayed"},
        {"page": "ProductPage", "action": "click_add_to_cart", "data_ref": null},
        {"page": "ProductPage", "assertion": "is_add_to_cart_disabled"},
        {"page": "ProductPage", "assertion": "is_error_message_displayed"},
        {"page": "CartPage", "assertion": "is_cart_item_present", "data_ref": null}
      ],
      "test_data": {
        "TD-04": {
          "product_id": "TD-04",
          "stock": 0
        }
      }
    },
    "1506": {
      "test_name": "test_cart_minimum_quantity_validation",
      "feature": "Cart Quantity Validation",
      "target_file": "test_cart_minimum_quantity.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_item_present", "data_ref": "TD-02"},
        {"page": "CartPage", "assertion": "is_quantity_displayed", "data_ref": {"product_id": "TD-02", "quantity": 5}},
        {"page": "CartPage", "action": "click_decrement", "data_ref": "TD-02"},
        {"page": "CartPage", "assertion": "is_validation_error_displayed"},
        {"page": "CartPage", "assertion": "is_quantity_displayed", "data_ref": {"product_id": "TD-02", "quantity": 5}},
        {"page": "CartPage", "assertion": "is_decrement_disabled", "data_ref": "TD-02"}
      ],
      "test_data": {
        "TD-02": {
          "product_id": "TD-02",
          "quantity": 5,
          "min_threshold": 5
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
