{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1497": {
      "test_name": "test_remove_product_from_cart",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_a_in_cart"},
        {"page": "CartPage", "action": "change_product_quantity", "data_ref": "change_quantity_to_zero"},
        {"page": "CartPage", "assertion": "validate_product_removed"},
        {"page": "CartPage", "action": "check_cart_totals", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_cart_totals"},
        {"page": "CartPage", "assertion": "validate_empty_cart_message"}
      ],
      "test_data": {
        "product_a_in_cart": {
          "product_name": "Wireless Mouse",
          "quantity": 3
        },
        "change_quantity_to_zero": {
          "product_name": "Wireless Mouse",
          "quantity": 0
        }
      }
    },
    "1498": {
      "test_name": "test_add_product_to_cart",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage", "ConfirmationPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_login"},
        {"page": "LoginPage", "assertion": "validate_login_success"},
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "ensure_cart_empty"},
        {"page": "ProductCatalogPage", "action": "browse_products", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_td01"},
        {"page": "ProductCatalogPage", "assertion": "validate_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "validate_product_in_stock"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_td01"},
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": "product_td01_in_cart"},
        {"page": "CartPage", "assertion": "validate_product_present"},
        {"page": "CartPage", "assertion": "validate_cart_totals"},
        {"page": "ConfirmationPage", "assertion": "validate_confirmation_message"}
      ],
      "test_data": {
        "user_login": {
          "username": "Jane Smith",
          "password": "PLACEHOLDER"
        },
        "ensure_cart_empty": {
          "product_name": null,
          "quantity": 0
        },
        "product_td01": {
          "product_name": "Organic Green Tea - 100g",
          "product_code": "TD-01",
          "quantity": 1,
          "in_stock": 50,
          "unit_price": 12.99,
          "subtotal": 12.99
        },
        "product_td01_in_cart": {
          "product_name": "Organic Green Tea - 100g",
          "quantity": 1
        },
        "confirmation_message": {
          "expected_message": "Product added to cart"
        }
      }
    }
  },
