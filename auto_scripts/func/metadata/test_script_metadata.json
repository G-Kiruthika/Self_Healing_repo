{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1491": {
      "test_name": "test_cart_quantity_and_inventory_validation",
      "feature": "Cart Quantity Validation",
      "target_file": "test_cart_quantity_and_inventory_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_product_in_cart", "data_ref": {"product_name": "Laptop Stand"}},
        {"page": "CartPage", "action": "validate_quantity", "data_ref": {"product_name": "Laptop Stand", "expected_quantity": 2}},
        {"page": "CartPage", "action": "validate_product_in_cart", "data_ref": {"product_name": "Laptop Stand"}},
        {"page": "CartPage", "action": "set_product_quantity", "data_ref": {"product_name": "Laptop Stand", "quantity": 10}},
        {"page": "CartPage", "assertion": "validate_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "validate_quantity", "data_ref": {"product_name": "Laptop Stand", "expected_quantity": 2}},
        {"page": "CartPage", "assertion": "validate_cart_total", "data_ref": {"expected_total": "unchanged"}}
      ],
      "test_data": {
        "cart": {
          "product_name": "Laptop Stand",
          "initial_quantity": 2,
          "stock": 5,
          "attempted_quantity": 10
        }
      }
    },
    "1492": {
      "test_name": "test_product_catalog_out_of_stock_add_to_cart",
      "feature": "Catalog Add To Cart Validation",
      "target_file": "test_product_catalog_out_of_stock_add_to_cart.py",
      "pages_used": ["ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "validate_product_visible", "data_ref": {"product_name": "USB Cable"}},
        {"page": "ProductCatalogPage", "assertion": "validate_stock_info", "data_ref": {"product_name": "USB Cable", "expected_stock": 0}},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": {"product_name": "USB Cable"}},
        {"page": "ProductCatalogPage", "assertion": "validate_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "validate_product_in_cart", "data_ref": {"product_name": "USB Cable", "should_exist": false}},
        {"page": "CartPage", "assertion": "validate_cart_total", "data_ref": {"expected_total": "unchanged"}}
      ],
      "test_data": {
        "product": {
          "product_name": "USB Cable",
          "stock": 0
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
