{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product", "data_ref": "add_product_a"},
        {"page": "CartPage", "action": "add_product", "data_ref": "add_product_b"},
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_product_a"},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_product_b"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "verify_cart_total"}
      ],
      "test_data": {
        "add_product_a": {"product_name": "Wireless Mouse", "quantity": 1},
        "add_product_b": {"product_name": "Coffee Subscription", "quantity": 3},
        "verify_product_a": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00},
        "verify_product_b": {"product_name": "Coffee Subscription", "quantity": 3, "subtotal": 47.97},
        "verify_cart_total": {"expected_total": 72.97}
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_verify_totals",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_product_a"},
        {"page": "CartPage", "action": "change_quantity", "data_ref": "change_quantity_a"},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_product_a_updated"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "verify_cart_total_updated"},
        {"page": "CartPage", "assertion": "verify_no_refresh_or_spinner", "data_ref": null}
      ],
      "test_data": {
        "verify_product_a": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00},
        "change_quantity_a": {"product_name": "Wireless Mouse", "quantity": 5},
        "verify_product_a_updated": {"product_name": "Wireless Mouse", "quantity": 5, "subtotal": 125.00},
        "verify_cart_total_updated": {"expected_total": 125.00}
      }
    }
  },
