  "test_cases": {
    "1511": {
      "test_name": "test_cart_quantity_increment_and_maximum",
      "feature": "Cart Quantity Management",
      "target_file": "test_cart_quantity_management.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "action": "set_quantity", "data_ref": "cart_item_td_03_initial"},
        {"page": "CartPage", "validation": "verify_cart_item"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "cart_item_td_03_incremented"},
        {"page": "CartPage", "validation": "verify_cart_item"},
        {"page": "CartPage", "validation": "verify_increment_disabled"},
        {"page": "CartPage", "validation": "verify_max_quantity_message"},
        {"page": "CartPage", "validation": "verify_subtotal"}
      ],
      "test_data": {
        "cart_item_td_03_initial": {
          "product_id": "TD-03",
          "quantity": 2,
          "stock": 3,
          "expected_subtotal": null
        },
        "cart_item_td_03_incremented": {
          "product_id": "TD-03",
          "quantity": 3,
          "expected_subtotal": 25.50
        }
      }
    },
    "1512": {
      "test_name": "test_cart_no_duplicate_on_add",
      "feature": "Cart Add Product Logic",
      "target_file": "test_cart_add_product_logic.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "action": "set_quantity", "data_ref": "cart_item_td_01_initial"},
        {"page": "CartPage", "validation": "verify_cart_item"},
        {"page": "ProductCatalogPage", "action": "navigate_to_product_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "product_catalog_add_td_01"},
        {"page": "CartPage", "validation": "verify_cart_item"},
        {"page": "CartPage", "validation": "verify_subtotal"},
        {"page": "CartPage", "validation": "verify_confirmation_message"}
      ],
      "test_data": {
        "cart_item_td_01_initial": {
          "product_id": "TD-01",
          "quantity": 2,
          "expected_subtotal": 25.98
        },
        "product_catalog_add_td_01": {
          "product_id": "TD-01"
        },
        "cart_item_td_01_incremented": {
          "product_id": "TD-01",
          "quantity": 3,
          "expected_subtotal": 38.97
        }
      }
    }
