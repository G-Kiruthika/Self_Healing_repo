{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1497": {
      "test_name": "test_remove_product_from_cart",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "set_product_quantity", "data_ref": "remove_product_a"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "action": "get_cart_totals", "data_ref": null},
        {"page": "CartPage", "assertion": "is_totals_correct"},
        {"page": "CartPage", "assertion": "is_empty_cart_message_displayed"}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 3
        },
        "remove_product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 0
        }
      }
    },
    "1498": {
      "test_name": "test_add_product_to_cart",
      "feature": "Catalog",
      "target_file": "test_catalog.py",
      "pages_used": ["LoginPage", "CatalogPage", "CartPage", "ConfirmationPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_jane"},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CatalogPage", "action": "find_product", "data_ref": "product_td01"},
        {"page": "CatalogPage", "assertion": "is_product_visible"},
        {"page": "CatalogPage", "assertion": "is_product_in_stock"},
        {"page": "CatalogPage", "action": "add_product_to_cart", "data_ref": "product_td01"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "assertion": "is_totals_correct"},
        {"page": "ConfirmationPage", "assertion": "is_confirmation_message_displayed"}
      ],
      "test_data": {
        "user_jane": {
          "username": "Jane Smith",
          "password": "<placeholder>"
        },
        "product_td01": {
          "product_name": "Organic Green Tea - 100g",
          "product_code": "TD-01",
          "stock": 50,
          "unit_price": 12.99,
          "quantity": 1,
          "subtotal": 12.99
        }
      }
    }
  },
