{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1489": {
      "test_name": "test_remove_product_c_and_verify_cart",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": {"product_name": "Product A"}},
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "action": "delete_product", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product C", "should_exist": false}},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": {"expected_total": "$25.00"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product A", "should_exist": true}}
      ],
      "test_data": {
        "cart_initial": {
          "products": [
            {"name": "Product A", "subtotal": "$25.00"},
            {"name": "Product C", "subtotal": "$89.99"}
          ]
        },
        "expected": {
          "remaining_products": ["Product A"],
          "cart_total": "$25.00"
        }
      }
    },
    "1490": {
      "test_name": "test_empty_cart_displays_message",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_cart_empty", "data_ref": null},
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_empty_cart_message_displayed", "data_ref": null},
        {"page": "CartPage", "assertion": "is_return_to_product_catalog_button_displayed", "data_ref": null}
      ],
      "test_data": {
        "cart_initial": {
          "products": []
        },
        "expected": {
          "message": "Your cart is empty",
          "show_button": true
        }
      }
    }
  },
