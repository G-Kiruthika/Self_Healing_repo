{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1483": {
      "test_name": "test_add_product_a_to_cart",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_credentials"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_a"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_count"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "user_credentials": {"username": "customer", "password": "password123"},
        "product_a": {"product_name": "Wireless Mouse", "expected_quantity": 1, "expected_subtotal": "25.00"},
        "cart": {"expected_count": 1}
      }
    },
    "1484": {
      "test_name": "test_add_product_b_with_min_threshold",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_credentials"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_b"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_min_threshold_displayed"},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "product_b"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_count"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "user_credentials": {"username": "customer", "password": "password123"},
        "product_b": {"product_name": "Coffee Subscription", "expected_quantity": 3, "expected_subtotal": "47.97", "min_threshold": 3},
        "cart": {"expected_count": 3}
      }
    }
  },
