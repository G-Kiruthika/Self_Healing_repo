      "test_name": "test_cart_delete_and_continue_shopping",
      "feature": "Cart",
      "target_file": "test_cart_delete_and_continue_shopping.py",
      "pages_used": ["CartPage", "CatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": {"product_id": "TD-01", "quantity": 1}},
        {"page": "CartPage", "action": "click_delete_button", "data_ref": {"product_id": "TD-01"}},
        {"page": "CartPage", "assertion": "verify_empty_cart_message_displayed"},
        {"page": "CartPage", "action": "click_continue_shopping"},
        {"page": "CartPage", "assertion": "verify_navigation_to_catalog"},
        {"page": "CartPage", "assertion": "verify_checkout_button_absent"}
      ],
      "test_data": {
        "product": {
          "product_id": "TD-01",
          "quantity": 1
        }
      }
    },
    "1504": {
      "test_name": "test_cart_quantity_inventory_validation",
      "feature": "Cart",
      "target_file": "test_cart_quantity_inventory_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": {"product_id": "TD-03", "quantity": 2, "stock": 3}},
        {"page": "CartPage", "action": "update_quantity", "data_ref": {"product_id": "TD-03", "quantity": 5}},
        {"page": "CartPage", "assertion": "verify_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "verify_quantity", "data_ref": {"product_id": "TD-03", "expected_quantity": 2}},
        {"page": "CartPage", "assertion": "verify_suggestion_message_displayed", "data_ref": {"max_available": 3}}
      ],
      "test_data": {
        "product": {
          "product_id": "TD-03",
          "quantity": 2,
          "stock": 3
        },
        "update_attempt": {
          "product_id": "TD-03",
          "quantity": 5
        }
      }
    }
