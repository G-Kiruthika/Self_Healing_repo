{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "action": "add_product", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "action": "add_product", "data_ref": "product_b"},
        {"page": "ShoppingCartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_b"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "cart_total"}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 1,
          "unit_price": 25.00,
          "subtotal": 25.00
        },
        "product_b": {
          "product_name": "Coffee Subscription",
          "quantity": 3,
          "unit_price": 15.99,
          "subtotal": 47.97
        },
        "cart_total": {
          "expected_total": 72.97
        }
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_verify_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "action": "change_quantity", "data_ref": "quantity_update"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a_updated"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "cart_total_updated"},
        {"page": "ShoppingCartPage", "assertion": "verify_no_page_refresh", "data_ref": null}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 1,
          "unit_price": 25.00,
          "subtotal": 25.00
        },
        "quantity_update": {
          "product_name": "Wireless Mouse",
          "quantity": 5
        },
        "product_a_updated": {
          "product_name": "Wireless Mouse",
          "quantity": 5,
          "unit_price": 25.00,
          "subtotal": 125.00
        },
        "cart_total_updated": {
          "expected_total": 125.00
        }
      }
    }
  },
