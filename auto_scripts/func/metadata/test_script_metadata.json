{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1485": {
      "test_name": "test_add_subscription_product_to_cart",
      "feature": "SubscriptionProductCart",
      "target_file": "test_subscription_product_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_credentials"},
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_d_min_threshold"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "assertion": "is_subscription_indicator_displayed"},
        {"page": "CartPage", "assertion": "verify_product_subtotal"}
      ],
      "test_data": {
        "user_credentials": {
          "username": "customer",
          "password": "password123"
        },
        "product_d_min_threshold": {
          "product_name": "Vitamin Pack",
          "quantity": 2
        },
        "expected_subtotal": {
          "product_name": "Vitamin Pack",
          "subtotal": "$91.00"
        }
      }
    },
    "1488": {
      "test_name": "test_update_subscription_product_quantity",
      "feature": "SubscriptionProductCart",
      "target_file": "test_subscription_product_cart.py",
      "pages_used": [
        "CartPage"
      ],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "action": "set_product_quantity", "data_ref": "increase_product_d_quantity"},
        {"page": "CartPage", "assertion": "verify_product_subtotal"},
        {"page": "CartPage", "assertion": "verify_cart_total"}
      ],
      "test_data": {
        "increase_product_d_quantity": {
          "product_name": "Vitamin Pack",
          "quantity": 6
        },
        "expected_subtotal": {
          "product_name": "Vitamin Pack",
          "subtotal": "$273.00"
        },
        "expected_cart_total": {
          "total": "$273.00"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": [
      "BasePage"
    ],
    "core_dependencies": [
      "core/driver_factory.py",
      "core/selenium_wrapper.py"
    ],
    "api_dependencies": [],
    "config_dependencies": [
      "config/config.yaml"
    ],
    "utils_dependencies": [],
    "external_libraries": [
      "selenium",
      "pytest",
      "pyyaml"
    ],
    "required_imports": [
      "pages.",
      "core.driver_factory",
      "pages.base_page"
    ]
  }
}
