{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1501": {
      "test_name": "test_increment_cart_item_quantity",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": "td_01_initial"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "td_01_increment"},
        {"page": "CartPage", "action": "verify_line_item_subtotal", "data_ref": "td_01_updated_subtotal"},
        {"page": "CartPage", "action": "verify_cart_total", "data_ref": "td_01_updated_total"},
        {"page": "CartPage", "assertion": "verify_no_page_reload"}
      ],
      "test_data": {
        "td_01_initial": {
          "product_code": "TD-01",
          "quantity": 1,
          "subtotal": 12.99
        },
        "td_01_increment": {
          "product_code": "TD-01"
        },
        "td_01_updated_subtotal": {
          "product_code": "TD-01",
          "expected_subtotal": 25.98
        },
        "td_01_updated_total": {
          "expected_total": 25.98
        }
      }
    },
    "1502": {
      "test_name": "test_delete_cart_item_and_recalculate",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": "td_01_02_initial"},
        {"page": "CartPage", "action": "delete_product", "data_ref": "td_01_delete"},
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": "td_02_remaining"},
        {"page": "CartPage", "action": "verify_cart_total", "data_ref": "td_02_total"},
        {"page": "CartPage", "assertion": "verify_confirmation_message"}
      ],
      "test_data": {
        "td_01_02_initial": {
          "product_code": ["TD-01", "TD-02"],
          "quantity": [2, 5],
          "subtotal": [25.98, 124.95],
          "total": 150.93
        },
        "td_01_delete": {
          "product_code": "TD-01"
        },
        "td_02_remaining": {
          "product_code": "TD-02",
          "quantity": 5,
          "subtotal": 124.95
        },
        "td_02_total": {
          "expected_total": 124.95
        },
        "verify_confirmation_message": {
          "expected_message": "Item removed from cart"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
