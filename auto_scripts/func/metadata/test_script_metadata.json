{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1501": {
      "test_name": "test_increment_cart_item_quantity",
      "feature": "Cart Functionality",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": "cart_item_1"},
        {"page": "CartPage", "action": "increment_product_quantity", "data_ref": "cart_item_1"},
        {"page": "CartPage", "assertion": "verify_cart_contains", "data_ref": "cart_item_2"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "cart_total_2"},
        {"page": "CartPage", "assertion": "verify_no_page_reload", "data_ref": null}
      ],
      "test_data": {
        "cart_item_1": {
          "product_id": "TD-01",
          "quantity": 1,
          "subtotal": 12.99
        },
        "cart_item_2": {
          "product_id": "TD-01",
          "quantity": 2,
          "subtotal": 25.98
        },
        "cart_total_2": {
          "expected_total": 25.98
        }
      }
    },
    "1502": {
      "test_name": "test_delete_cart_item_and_verify_total",
      "feature": "Cart Functionality",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_cart_contains", "data_ref": "cart_item_td01_and_td02"},
        {"page": "CartPage", "action": "delete_product", "data_ref": "delete_td01"},
        {"page": "CartPage", "assertion": "verify_cart_contains", "data_ref": "cart_item_td02_only"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "cart_total_td02"},
        {"page": "CartPage", "assertion": "verify_confirmation_message", "data_ref": "confirmation_message"}
      ],
      "test_data": {
        "cart_item_td01_and_td02": {
          "products": [
            {"product_id": "TD-01", "quantity": 2, "subtotal": 25.98},
            {"product_id": "TD-02", "quantity": 5, "subtotal": 124.95}
          ],
          "expected_total": 150.93
        },
        "delete_td01": {
          "product_id": "TD-01"
        },
        "cart_item_td02_only": {
          "products": [
            {"product_id": "TD-02", "quantity": 5, "subtotal": 124.95}
          ]
        },
        "cart_total_td02": {
          "expected_total": 124.95
        },
        "confirmation_message": {
          "expected_message": "Item removed from cart"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
