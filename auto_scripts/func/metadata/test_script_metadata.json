{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1497": {
      "test_name": "test_remove_product_from_cart",
      "feature": "Cart Management",
      "target_file": "test_cart_management.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "set_quantity", "data_ref": {"product_name": "Wireless Mouse", "quantity": 0}},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CartPage", "action": "get_cart_totals", "data_ref": null},
        {"page": "CartPage", "assertion": "empty_cart_message_displayed"}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 3
        }
      }
    },
    "1498": {
      "test_name": "test_add_product_to_cart_and_verify",
      "feature": "Shopping Cart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage", "ConfirmationMessage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_jane"},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "ProductCatalogPage", "action": "find_product", "data_ref": "product_td01"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_product_in_stock"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_td01"},
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "product_td01"},
        {"page": "CartPage", "assertion": "cart_totals_are_correct"},
        {"page": "ConfirmationMessage", "assertion": "confirmation_message_displayed"}
      ],
      "test_data": {
        "user_jane": {
          "username": "Jane Smith",
          "cart_empty": true
        },
        "product_td01": {
          "product_name": "Organic Green Tea - 100g",
          "product_code": "TD-01",
          "stock": 50,
          "unit_price": 12.99,
          "quantity": 1
        },
        "confirmation": {
          "expected_message": "Product added to cart"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
