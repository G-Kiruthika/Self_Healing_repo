{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1501": {
      "test_name": "test_increment_cart_item_quantity",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "TD-01_initial"},
        {"page": "CartPage", "action": "click_increment", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "validate_cart_item", "data_ref": "TD-01_incremented"},
        {"page": "CartPage", "assertion": "validate_cart_total", "data_ref": "TD-01_incremented"},
        {"page": "CartPage", "assertion": "validate_no_page_reload", "data_ref": null}
      ],
      "test_data": {
        "TD-01_initial": {"product_code": "TD-01", "quantity": 1, "subtotal": 12.99},
        "TD-01": {"product_code": "TD-01"},
        "TD-01_incremented": {"product_code": "TD-01", "quantity": 2, "subtotal": 25.98, "total_amount": 25.98}
      }
    },
    "1502": {
      "test_name": "test_delete_cart_item",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_cart_contains", "data_ref": "multi_items_initial"},
        {"page": "CartPage", "action": "click_delete", "data_ref": "TD-01"},
        {"page": "CartPage", "assertion": "validate_cart_item", "data_ref": "TD-02_only"},
        {"page": "CartPage", "assertion": "validate_cart_total", "data_ref": "TD-02_only"},
        {"page": "CartPage", "assertion": "validate_confirmation_message", "data_ref": "removed_message"}
      ],
      "test_data": {
        "multi_items_initial": {
          "items": [
            {"product_code": "TD-01", "quantity": 2, "subtotal": 25.98},
            {"product_code": "TD-02", "quantity": 5, "subtotal": 124.95}
          ],
          "total_amount": 150.93
        },
        "TD-01": {"product_code": "TD-01"},
        "TD-02_only": {"product_code": "TD-02", "quantity": 5, "subtotal": 124.95, "total_amount": 124.95},
        "removed_message": {"message": "Item removed from cart"}
      }
    }
  },
