{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1511": {
      "test_name": "test_cart_increment_max_quantity",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup_td_03"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "cart_increment_td_03"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_increment_button_disabled"},
        {"page": "CartPage", "assertion": "verify_max_quantity_message_displayed"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "cart_setup_td_03": {"sku": "TD-03", "quantity": 2, "stock": 3},
        "cart_increment_td_03": {"sku": "TD-03", "quantity": 3},
        "expected_subtotal": {"sku": "TD-03", "subtotal": "$25.50"}
      }
    },
    "1512": {
      "test_name": "test_cart_add_to_cart_existing_item",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup_td_01"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "product_add_to_cart_td_01"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_subtotal"},
        {"page": "CartPage", "assertion": "verify_confirmation_message"}
      ],
      "test_data": {
        "cart_setup_td_01": {"sku": "TD-01", "quantity": 2, "subtotal": "$25.98"},
        "product_add_to_cart_td_01": {"sku": "TD-01"},
        "expected_cart_td_01": {"sku": "TD-01", "quantity": 3, "subtotal": "$38.97"},
        "expected_confirmation": {"message": "Quantity updated in cart"}
      }
    }
  },
