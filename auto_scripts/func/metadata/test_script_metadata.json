{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1491": {
      "test_name": "test_update_cart_with_insufficient_stock",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "assertion": "is_quantity_correct"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "update_quantity"},
        {"page": "CartPage", "assertion": "is_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "is_quantity_correct"},
        {"page": "CartPage", "assertion": "is_cart_total_correct"}
      ],
      "test_data": {
        "initial_cart": {
          "product_name": "Laptop Stand",
          "quantity": 2,
          "available_stock": 5
        },
        "update_quantity": {
          "product_name": "Laptop Stand",
          "quantity": 10
        }
      }
    },
    "1492": {
      "test_name": "test_add_out_of_stock_product_to_cart",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": ["ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "ProductCatalogPage", "action": "navigate_to_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_stock_info_displayed"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "add_product"},
        {"page": "ProductCatalogPage", "assertion": "is_inventory_error_displayed"},
        {"page": "ProductCatalogPage", "assertion": "is_cart_count_unchanged"}
      ],
      "test_data": {
        "add_product": {
          "product_name": "USB Cable",
          "available_stock": 0
        }
      }
    }
  },
