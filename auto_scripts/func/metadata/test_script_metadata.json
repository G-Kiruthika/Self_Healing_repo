      "test_name": "test_add_premium_coffee_beans_to_cart_min_threshold",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user_john_doe"},
