{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1503": {
      "test_name": "test_cart_delete_and_empty_state",
      "feature": "ShoppingCart",
      "target_file": "test_cart_delete_and_empty_state.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "cart_with_td01"},
        {"page": "CartPage", "action": "delete_product", "data_ref": "td01"},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CartPage", "assertion": "is_empty_cart_message_displayed"},
        {"page": "CartPage", "assertion": "is_continue_shopping_button_displayed"},
        {"page": "CartPage", "action": "click_continue_shopping"},
        {"page": "ProductCatalogPage", "assertion": "is_catalog_displayed"},
        {"page": "CartPage", "assertion": "is_checkout_button_unavailable"}
      ],
      "test_data": {
        "cart_with_td01": {"cart": [{"product_id": "TD-01", "quantity": 1}]},
        "td01": {"product_id": "TD-01"}
      }
    },
    "1504": {
      "test_name": "test_cart_quantity_exceeds_stock",
      "feature": "ShoppingCart",
      "target_file": "test_cart_quantity_exceeds_stock.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": "cart_with_td03"},
        {"page": "CartPage", "action": "update_quantity", "data_ref": "td03_update_5"},
        {"page": "CartPage", "assertion": "is_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "is_quantity_equal", "data_ref": "td03_quantity_2"},
        {"page": "CartPage", "assertion": "is_suggestion_message_displayed"}
      ],
      "test_data": {
        "cart_with_td03": {"cart": [{"product_id": "TD-03", "quantity": 2, "stock": 3}]},
        "td03_update_5": {"product_id": "TD-03", "quantity": 5},
        "td03_quantity_2": {"product_id": "TD-03", "expected_quantity": 2}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
