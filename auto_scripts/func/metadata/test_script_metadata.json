{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "action": "add_product_to_cart", "data_ref": "product_a_add"},
        {"page": "ShoppingCartPage", "action": "add_product_to_cart", "data_ref": "product_b_add"},
        {"page": "ShoppingCartPage", "action": "navigate_to_cart"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a_verify"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_b_verify"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "overall_total"}
      ],
      "test_data": {
        "product_a_add": {"product_name": "Wireless Mouse", "quantity": 1},
        "product_b_add": {"product_name": "Coffee Subscription", "quantity": 3},
        "product_a_verify": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00},
        "product_b_verify": {"product_name": "Coffee Subscription", "quantity": 3, "subtotal": 47.97},
        "overall_total": {"expected_total": 72.97}
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_verify_totals",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a_initial"},
        {"page": "ShoppingCartPage", "action": "change_product_quantity", "data_ref": "product_a_update"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "product_a_updated_verify"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "updated_total"},
        {"page": "ShoppingCartPage", "assertion": "verify_no_loading_spinner"}
      ],
      "test_data": {
        "product_a_initial": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00},
        "product_a_update": {"product_name": "Wireless Mouse", "quantity": 5},
        "product_a_updated_verify": {"product_name": "Wireless Mouse", "quantity": 5, "subtotal": 125.00},
        "updated_total": {"expected_total": 125.00}
      }
    }
  },
