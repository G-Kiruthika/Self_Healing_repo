{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "TC_001": {
      "test_name": "test_add_product_a_to_cart",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "user1"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "user1"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "LoginPage", "assertion": "is_logged_in"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_a"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_count"},
        {"page": "CartPage", "assertion": "is_subtotal_correct"}
      ],
      "test_data": {
        "user1": {"username": "customer", "password": "customerPass"},
        "product_a": {"name": "Wireless Mouse", "expected_subtotal": "$25.00", "expected_count": 1}
      }
    },
    "TC_002": {
      "test_name": "test_add_product_b_with_minimum_threshold",
      "feature": "ProductCatalog",
      "target_file": "test_product_catalog.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "user1"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "user1"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "LoginPage", "assertion": "is_logged_in"},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "product_b"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ProductCatalogPage", "assertion": "is_threshold_visible"},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart", "data_ref": "product_b"},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_count"},
        {"page": "CartPage", "assertion": "is_subtotal_correct"}
      ],
      "test_data": {
        "user1": {"username": "customer", "password": "customerPass"},
        "product_b": {"name": "Coffee Subscription", "minimum_threshold": 3, "expected_subtotal": "$47.97", "expected_count": 3}
      }
    }
  },
