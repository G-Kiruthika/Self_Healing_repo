{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "290": {
      "test_name": "test_add_update_remove_cart",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "product_add"},
        {"page": "CartPage", "assertion": "verify_product_in_cart"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "product_update"},
        {"page": "CartPage", "action": "remove_product_from_cart", "data_ref": "product_remove"},
        {"page": "CartPage", "assertion": "verify_cart_updated_without_refresh"}
      ],
      "test_data": {
        "product_add": {"product_name": "Wireless Mouse", "quantity": 1},
        "product_update": {"product_name": "Wireless Mouse", "quantity": 2},
        "product_remove": {"product_name": "Wireless Mouse"}
      }
    },
    "291": {
      "test_name": "test_prevent_negative_quantity",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "negative_quantity"},
        {"page": "CartPage", "assertion": "verify_no_product_with_negative_quantity"}
      ],
      "test_data": {
        "negative_quantity": {"product_name": "Wireless Mouse", "quantity": -1}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
