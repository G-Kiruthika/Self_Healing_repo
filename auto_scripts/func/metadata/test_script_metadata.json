        {"page": "ProductCatalogPage", "action": "verify_product_visible", "data_ref": "product_e"},
        {"page": "ProductCatalogPage", "action": "verify_stock_info", "data_ref": "product_e"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_e"},
        {"page": "ProductCatalogPage", "assertion": "verify_inventory_error_displayed"},
        {"page": "HeaderPage", "assertion": "verify_cart_count"}
      ],
