{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1491": {
      "test_name": "test_cart_quantity_inventory_validation",
      "feature": "Cart Quantity and Inventory Validation",
      "target_file": "test_cart_quantity_inventory_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_product_in_cart", "data_ref": "product_c_in_cart"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "update_product_c_quantity"},
        {"page": "CartPage", "assertion": "validate_inventory_error_displayed"},
        {"page": "CartPage", "action": "view_cart_totals", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_cart_totals"}
      ],
      "test_data": {
        "product_c_in_cart": {
          "product_name": "Laptop Stand",
          "quantity": 2,
          "stock": 5
        },
        "update_product_c_quantity": {
          "product_name": "Laptop Stand",
          "quantity": 10
        },
        "validate_cart_totals": {
          "expected_totals": "unchanged"
        }
      }
    },
    "1492": {
      "test_name": "test_add_out_of_stock_product_to_cart",
      "feature": "Add Out-of-Stock Product to Cart",
      "target_file": "test_add_out_of_stock_product_to_cart.py",
      "pages_used": ["ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "ProductCatalogPage", "action": "navigate_to_product_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "validate_product_visible", "data_ref": "product_e_visible"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "add_product_e"},
        {"page": "ProductCatalogPage", "assertion": "validate_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "validate_cart_totals"}
      ],
      "test_data": {
        "product_e_visible": {
          "product_name": "USB Cable",
          "stock": 0
        },
        "add_product_e": {
          "product_name": "USB Cable"
        },
        "validate_cart_totals": {
          "expected_totals": "unchanged"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
