{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1503": {
      "test_name": "test_cart_deletion_and_empty_cart_flow",
      "feature": "Cart",
      "target_file": "test_cart_deletion_and_empty_cart_flow.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": {"product_code": "TD-01"}},
        {"page": "CartPage", "action": "delete_product", "data_ref": {"product_code": "TD-01"}},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CartPage", "assertion": "is_empty_cart_message_displayed"},
        {"page": "CartPage", "assertion": "is_continue_shopping_button_visible"},
        {"page": "CartPage", "action": "click_continue_shopping", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "is_on_catalog_page"},
        {"page": "CartPage", "assertion": "is_checkout_button_disabled_or_hidden"}
      ],
      "test_data": {
        "initial_cart": {"product_code": "TD-01"}
      }
    },
    "1504": {
      "test_name": "test_cart_quantity_update_inventory_validation",
      "feature": "Cart",
      "target_file": "test_cart_quantity_update_inventory_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": {"product_code": "TD-03", "quantity": 2, "stock": 3}},
        {"page": "CartPage", "action": "update_quantity", "data_ref": {"product_code": "TD-03", "quantity": 5}},
        {"page": "CartPage", "assertion": "is_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "is_error_message_displayed", "data_ref": {"expected_message": "Only 3 units available in stock"}},
        {"page": "CartPage", "assertion": "is_quantity_set", "data_ref": {"product_code": "TD-03", "expected_quantity": 2}},
        {"page": "CartPage", "assertion": "is_suggestion_message_displayed", "data_ref": {"expected_message": "Maximum available: 3"}}
      ],
      "test_data": {
        "initial_cart": {"product_code": "TD-03", "quantity": 2, "stock": 3},
        "invalid_quantity_attempt": {"product_code": "TD-03", "quantity": 5}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}