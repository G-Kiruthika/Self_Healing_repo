{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1507": {
      "test_name": "test_cart_displays_multiple_products",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "action": "navigate_to_cart_page", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_id": "TD-01", "expected_qty": 1}},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_id": "TD-02", "expected_qty": 1}},
        {"page": "ShoppingCartPage", "assertion": "verify_product_fields", "data_ref": {"product_id": "TD-01"}},
        {"page": "ShoppingCartPage", "assertion": "verify_product_fields", "data_ref": {"product_id": "TD-02"}},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": "$150.93"}}
      ],
      "test_data": {
        "cart_items": {
          "TD-01": {"quantity": 1, "unit_price": null},
          "TD-02": {"quantity": 1, "unit_price": null}
        },
        "expected_total": "$150.93"
      }
    },
    "1508": {
      "test_name": "test_update_quantity_in_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "action": "navigate_to_cart_page", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_id": "TD-01", "expected_qty": 1}},
        {"page": "ShoppingCartPage", "action": "update_quantity", "data_ref": {"product_id": "TD-01", "quantity": 10}},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_id": "TD-01", "expected_qty": 10}},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": "$129.90"}},
        {"page": "ShoppingCartPage", "assertion": "verify_success_message", "data_ref": {"expected_message": "Quantity updated"}}
      ],
      "test_data": {
        "cart_items": {
          "TD-01": {"quantity": 1, "unit_price": null, "stock": 50}
        },
        "update_quantity": 10,
        "expected_total": "$129.90",
        "expected_message": "Quantity updated"
      }
    }
  },
