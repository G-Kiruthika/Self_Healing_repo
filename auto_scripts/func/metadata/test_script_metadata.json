{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1509": {
      "test_name": "test_cart_negative_quantity_validation",
      "feature": "Cart Quantity Validation",
      "target_file": "test_cart_negative_quantity_validation.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_cart_item_quantity", "data_ref": {"item": "TD-01", "quantity": 2}},
        {"page": "CartPage", "action": "set_quantity", "data_ref": {"quantity": -5}},
        {"page": "CartPage", "action": "click_update_button", "data_ref": null},
        {"page": "CartPage", "assertion": "validate_error_message", "data_ref": {"expected_message": "Quantity must be a positive number"}},
        {"page": "CartPage", "assertion": "validate_cart_item_quantity", "data_ref": {"item": "TD-01", "quantity": 2}},
        {"page": "CartPage", "assertion": "validate_cart_totals", "data_ref": {"expected_totals": "unchanged"}}
      ],
      "test_data": {
        "valid_cart_item": {"item": "TD-01", "quantity": 2},
        "invalid_quantity": {"quantity": -5},
        "expected_error": {"message": "Quantity must be a positive number"},
        "expected_totals": {"status": "unchanged"}
      }
    },
    "1510": {
      "test_name": "test_cart_minimum_threshold_controls",
      "feature": "Cart Minimum Threshold Controls",
      "target_file": "test_cart_minimum_threshold_controls.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "validate_cart_item_quantity", "data_ref": {"item": "TD-02", "quantity": 5}},
        {"page": "CartPage", "assertion": "validate_button_state", "data_ref": {"button": "decrement", "expected_state": "disabled"}},
        {"page": "CartPage", "assertion": "validate_button_state", "data_ref": {"button": "increment", "expected_state": "enabled"}},
        {"page": "CartPage", "assertion": "validate_line_item_subtotal", "data_ref": {"item": "TD-02", "expected_subtotal": 124.95}},
        {"page": "CartPage", "assertion": "validate_threshold_indicator", "data_ref": {"item": "TD-02", "expected_indicator": "Min: 5 units"}}
      ],
      "test_data": {
        "valid_cart_item": {"item": "TD-02", "quantity": 5, "threshold": 5},
        "expected_button_states": {"decrement": "disabled", "increment": "enabled"},
        "expected_subtotal": {"item": "TD-02", "subtotal": 124.95},
        "expected_indicator": {"item": "TD-02", "indicator": "Min: 5 units"}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
