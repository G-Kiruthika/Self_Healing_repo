{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1489": {
      "test_name": "test_remove_product_from_cart",
      "feature": "ShoppingCart",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": {"product_name": "Product A", "subtotal": "$25.00"}},
        {"page": "CartPage", "action": "ensure_product_in_cart", "data_ref": {"product_name": "Product C", "subtotal": "$89.99"}},
        {"page": "CartPage", "assertion": "verify_product_present", "data_ref": {"product_name": "Product A"}},
        {"page": "CartPage", "assertion": "verify_product_present", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "action": "click_delete_for_product", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "verify_product_not_present", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "action": "observe_cart_page", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": "$25.00"}},
        {"page": "CartPage", "assertion": "verify_only_product_remains", "data_ref": {"product_name": "Product A"}}
      ],
      "test_data": {
        "products": {
          "Product A": {"subtotal": "$25.00"},
          "Product C": {"subtotal": "$89.99"}
        },
        "expected_cart_total": "$25.00"
      }
    },
    "1490": {
      "test_name": "test_empty_cart_behavior",
      "feature": "ShoppingCart",
      "target_file": "test_cart_page.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "observe_cart_page", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_cart_empty", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_empty_cart_message_displayed", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_return_to_catalog_button_displayed", "data_ref": null}
      ],
      "test_data": {
        "cart_state": "empty"
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
