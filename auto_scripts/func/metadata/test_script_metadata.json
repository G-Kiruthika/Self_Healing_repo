      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ProductPage", "CartPage"],
      "flow": [
        {"page": "ProductPage", "action": "add_product_to_cart", "data_ref": "product_a_1"},
        {"page": "ProductPage", "action": "add_product_to_cart", "data_ref": "product_b_3"},
        {"page": "ProductPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_on_cart_page"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_a_1"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_b_3"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "total_72_97"}
      ],
      "test_data": {
        "product_a_1": {"product_name": "Wireless Mouse", "unit_price": 25.00, "quantity": 1, "subtotal": 25.00},
        "product_b_3": {"product_name": "Coffee Subscription", "unit_price": 15.99, "quantity": 3, "subtotal": 47.97},
        "total_72_97": {"cart_total": 72.97}
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_verify_totals",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_a_1"},
        {"page": "CartPage", "action": "change_product_quantity", "data_ref": "product_a_5"},
        {"page": "CartPage", "assertion": "verify_product_details", "data_ref": "product_a_5"},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": "total_125_00"},
        {"page": "CartPage", "assertion": "no_page_refresh_or_spinner", "data_ref": null}
      ],
      "test_data": {
        "product_a_1": {"product_name": "Wireless Mouse", "unit_price": 25.00, "quantity": 1, "subtotal": 25.00},
        "product_a_5": {"product_name": "Wireless Mouse", "unit_price": 25.00, "quantity": 5, "subtotal": 125.00},
        "total_125_00": {"cart_total": 125.00}
      }
    }
