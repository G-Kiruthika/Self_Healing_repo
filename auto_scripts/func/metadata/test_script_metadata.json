{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "290": {
      "test_name": "test_add_update_remove_cart",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "add_mouse"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "action": "update_product_quantity", "data_ref": "update_quantity"},
        {"page": "CartPage", "assertion": "is_cart_updated_instantly"},
        {"page": "CartPage", "assertion": "is_no_page_refresh_on_update"}
      ],
      "test_data": {
        "add_mouse": {"product_name": "Wireless Mouse", "quantity": 1},
        "update_quantity": {"product_name": "Wireless Mouse", "quantity": 2}
      }
    },
    "291": {
      "test_name": "test_prevent_negative_quantity",
      "feature": "Cart Functionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": "add_negative_mouse"},
        {"page": "CartPage", "assertion": "is_negative_quantity_prevented"},
        {"page": "CartPage", "action": "submit_cart_update", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart"}
      ],
      "test_data": {
        "add_negative_mouse": {"product_name": "Wireless Mouse", "quantity": -1}
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}