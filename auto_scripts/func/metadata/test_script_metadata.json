{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_add_multiple_products_and_verify_cart",
      "feature": "Shopping Cart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "action": "add_product_to_cart", "data_ref": "add_products"},
        {"page": "ShoppingCartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_products"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "verify_total"}
      ],
      "test_data": {
        "add_products": {
          "products": [
            {"name": "Wireless Mouse", "quantity": 1},
            {"name": "Coffee Subscription", "quantity": 3}
          ]
        },
        "verify_products": {
          "products": [
            {"name": "Wireless Mouse", "unit_price": 25.00, "quantity": 1, "subtotal": 25.00},
            {"name": "Coffee Subscription", "unit_price": 15.99, "quantity": 3, "subtotal": 47.97}
          ]
        },
        "verify_total": {
          "total": 72.97
        }
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_verify_totals",
      "feature": "Shopping Cart",
      "target_file": "test_shopping_cart.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_initial_product"},
        {"page": "ShoppingCartPage", "action": "change_product_quantity", "data_ref": "change_quantity"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_in_cart", "data_ref": "verify_updated_product"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "verify_total"},
        {"page": "ShoppingCartPage", "assertion": "verify_no_page_refresh_or_spinner", "data_ref": null}
      ],
      "test_data": {
        "verify_initial_product": {
          "product": {"name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00}
        },
        "change_quantity": {
          "product": {"name": "Wireless Mouse", "quantity": 5}
        },
        "verify_updated_product": {
          "product": {"name": "Wireless Mouse", "quantity": 5, "subtotal": 125.00}
        },
        "verify_total": {
          "total": 125.00
        }
      }
    }
  },
