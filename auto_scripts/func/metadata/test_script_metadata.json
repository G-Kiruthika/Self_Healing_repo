        {"page": "CartPage", "assertion": "validate_product_present", "data_ref": {"product_name": "Product A"}},
        {"page": "CartPage", "assertion": "validate_product_present", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "action": "click_delete_button", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "validate_product_not_present", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "validate_cart_total", "data_ref": {"expected_total": "$25.00"}},
        {"page": "CartPage", "assertion": "validate_product_present", "data_ref": {"product_name": "Product A"}}
      ],
      "test_data": {
        "default": {
          "product_a_name": "Product A",
