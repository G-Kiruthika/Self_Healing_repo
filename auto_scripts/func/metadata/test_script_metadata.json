{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "275": {
      "test_name": "test_guest_adds_wireless_mouse_to_cart",
      "feature": "Product Catalog",
      "target_file": "test_guest_adds_wireless_mouse_to_cart.py",
      "pages_used": ["ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "is_catalog_displayed"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "assertion": "is_quantity_set", "data_ref": {"product_name": "Wireless Mouse", "expected_quantity": 3}}
      ],
      "test_data": {
        "wireless_mouse": {
          "product_name": "Wireless Mouse",
          "expected_quantity": 3
        }
      }
    },
    "276": {
      "test_name": "test_non_subscriber_adds_wireless_mouse_to_cart",
      "feature": "Cart",
      "target_file": "test_non_subscriber_adds_wireless_mouse_to_cart.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "non_subscriber"},
        {"page": "LoginPage", "assertion": "is_logged_in_as", "data_ref": {"role": "non-subscriber"}},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "action": "view_cart", "data_ref": null},
        {"page": "CartPage", "action": "get_product_quantity", "data_ref": "wireless_mouse"},
        {"page": "CartPage", "assertion": "is_quantity_set", "data_ref": {"product_name": "Wireless Mouse", "expected_quantity": 3}}
      ],
      "test_data": {
        "non_subscriber": {
          "username": "non_sub_user",
          "password": "<to-be-supplied>",
          "role": "non-subscriber"
        },
        "wireless_mouse": {
          "product_name": "Wireless Mouse",
          "expected_quantity": 3
        }
      }
    }
  },
