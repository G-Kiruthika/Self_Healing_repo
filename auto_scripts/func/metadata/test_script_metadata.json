{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1485": {
      "test_name": "test_add_subscription_product_to_cart",
      "feature": "Product Catalog and Cart",
      "target_file": "test_product_cart_subscription.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "customer_credentials"},
        {"page": "ProductCatalogPage", "action": "navigate_to", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_d_min_subscription"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "assertion": "is_subscription_indicator_displayed"},
        {"page": "CartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "customer_credentials": {
          "username": "customer_user",
          "password": "customer_pass"
        },
        "product_d_min_subscription": {
          "product_name": "Vitamin Pack",
          "quantity": 2
        },
        "expected_subtotal": {
          "product_name": "Vitamin Pack",
          "expected_subtotal": "$91.00"
        }
      }
    },
    "1488": {
      "test_name": "test_update_subscription_product_quantity",
      "feature": "Cart Quantity Update",
      "target_file": "test_product_cart_subscription.py",
      "pages_used": [
        "CartPage"
      ],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_in_cart"},
        {"page": "CartPage", "action": "increase_quantity", "data_ref": "update_quantity_to_6"},
        {"page": "CartPage", "assertion": "verify_subtotal"},
        {"page": "CartPage", "assertion": "verify_cart_total"}
      ],
      "test_data": {
        "update_quantity_to_6": {
          "product_name": "Vitamin Pack",
          "quantity": 6
        },
        "expected_subtotal": {
          "product_name": "Vitamin Pack",
          "expected_subtotal": "$273.00"
        },
        "expected_cart_total": {
          "expected_total": "$273.00"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": ["core/driver_factory.py", "core/selenium_wrapper.py"],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}