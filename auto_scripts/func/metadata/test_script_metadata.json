{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1495": {
      "test_name": "test_delete_product_and_verify_cart_empty",
      "feature": "CartFunctionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "is_product_in_cart", "data_ref": {"product_name": "Wireless Mouse"}},
        {"page": "CartPage", "action": "delete_product", "data_ref": {"product_name": "Wireless Mouse"}},
        {"page": "CartPage", "assertion": "is_cart_empty"},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": {"amount": "$0.00"}}
      ],
      "test_data": {
        "product_A": {
          "product_name": "Wireless Mouse",
          "initial_quantity": 1
        }
      }
    },
    "1496": {
      "test_name": "test_add_multiple_products_and_verify_totals",
      "feature": "CartFunctionality",
      "target_file": "test_cart_functionality.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product", "data_ref": {"product_name": "Product A", "quantity": 2}},
        {"page": "CartPage", "action": "add_product", "data_ref": {"product_name": "Product B", "quantity": 3}},
        {"page": "CartPage", "action": "add_product", "data_ref": {"product_name": "Product C", "quantity": 1}},
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product A"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product B"}},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": {"product_name": "Product C"}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product A", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product B", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_line_item_subtotal", "data_ref": {"product_name": "Product C", "expected_subtotal": null}},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": {"amount": "$187.96"}}
      ],
      "test_data": {
        "product_A": {"product_name": "Product A", "quantity": 2},
        "product_B": {"product_name": "Product B", "quantity": 3},
        "product_C": {"product_name": "Product C", "quantity": 1}
      }
    }
  },
