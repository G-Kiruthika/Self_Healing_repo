{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1511": {
      "test_name": "test_cart_increment_max_quantity",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup_td_03"},
        {"page": "CartPage", "action": "increment_quantity", "data_ref": "increment_td_03"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_increment_button_disabled"},
        {"page": "CartPage", "assertion": "verify_max_quantity_message_displayed"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"}
      ],
      "test_data": {
        "cart_setup_td_03": {"sku": "TD-03", "quantity": 2, "stock": 3},
        "increment_td_03": {"sku": "TD-03"},
        "expected_quantity": 3,
        "expected_subtotal": 25.50
      }
    },
    "1512": {
      "test_name": "test_add_to_cart_prevent_duplicate",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage", "ProductCatalogPage"],
      "flow": [
        {"page": "CartPage", "action": "set_cart_item_quantity", "data_ref": "cart_setup_td_01"},
        {"page": "ProductCatalogPage", "action": "navigate_to_product_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "add_to_cart", "data_ref": "add_to_cart_td_01"},
        {"page": "CartPage", "assertion": "verify_cart_item_quantity"},
        {"page": "CartPage", "assertion": "verify_line_item_subtotal"},
        {"page": "CartPage", "assertion": "verify_confirmation_message_displayed"}
      ],
      "test_data": {
        "cart_setup_td_01": {"sku": "TD-01", "quantity": 2, "subtotal": 25.98},
        "add_to_cart_td_01": {"sku": "TD-01"},
        "expected_quantity": 3,
        "expected_subtotal": 38.97
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
