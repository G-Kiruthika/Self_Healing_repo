      "test_name": "test_remove_product_c_from_cart",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "Product A"},
        {"page": "CartPage", "assertion": "is_product_in_cart", "data_ref": "Product C"},
        {"page": "CartPage", "action": "delete_product", "data_ref": "Product C"},
        {"page": "CartPage", "assertion": "is_product_not_in_cart", "data_ref": "Product C"},
        {"page": "CartPage", "action": "observe_cart_page", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_total", "data_ref": "$25.00"},
        {"page": "CartPage", "assertion": "is_only_product_in_cart", "data_ref": "Product A"}
      ],
      "test_data": {
        "cart_products": {
          "Product A": {"subtotal": "$25.00"},
          "Product C": {"subtotal": "$89.99"}
        },
        "expected_cart_total": "$25.00"
      }
    },
