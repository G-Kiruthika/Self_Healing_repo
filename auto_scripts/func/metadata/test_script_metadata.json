{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_add_multiple_products_and_validate_cart",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": {"product_name": "Wireless Mouse", "quantity": 1}},
        {"page": "CartPage", "action": "add_product_to_cart", "data_ref": {"product_name": "Coffee Subscription", "quantity": 3}},
        {"page": "CartPage", "action": "navigate_to_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00}},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_name": "Coffee Subscription", "quantity": 3, "subtotal": 47.97}},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": 72.97}}
      ],
      "test_data": {
        "product_a": {"product_name": "Wireless Mouse", "unit_price": 25.00, "quantity": 1, "subtotal": 25.00},
        "product_b": {"product_name": "Coffee Subscription", "unit_price": 15.99, "quantity": 3, "subtotal": 47.97},
        "overall_total": 72.97
      }
    },
    "1487": {
      "test_name": "test_update_product_quantity_and_validate_totals",
      "feature": "Cart",
      "target_file": "test_cart.py",
      "pages_used": ["CartPage"],
      "flow": [
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_name": "Wireless Mouse", "quantity": 1, "subtotal": 25.00}},
        {"page": "CartPage", "action": "change_product_quantity", "data_ref": {"product_name": "Wireless Mouse", "quantity": 5}},
        {"page": "CartPage", "assertion": "verify_product_in_cart", "data_ref": {"product_name": "Wireless Mouse", "quantity": 5, "subtotal": 125.00}},
        {"page": "CartPage", "assertion": "verify_cart_total", "data_ref": {"expected_total": 125.00}},
        {"page": "CartPage", "assertion": "verify_no_page_refresh_or_spinner", "data_ref": null}
      ],
      "test_data": {
        "product_a": {"product_name": "Wireless Mouse", "unit_price": 25.00, "quantity": 5, "subtotal": 125.00},
        "overall_total": 125.00
      }
    }
  },
