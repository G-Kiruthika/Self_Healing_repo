  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1491": {
      "test_name": "test_cart_quantity_update_validation",
      "feature": "CartQuantityValidation",
      "target_file": "test_cart_quantity_update_validation.py",
      "pages_used": ["CartPage", "HeaderPage"],
      "flow": [
        {"page": "CartPage", "action": "verify_product_in_cart", "data_ref": "product_c"},
        {"page": "CartPage", "action": "set_quantity", "data_ref": "update_quantity_attempt"},
        {"page": "CartPage", "action": "click_update", "data_ref": "product_c"},
        {"page": "CartPage", "assertion": "verify_inventory_error_displayed"},
        {"page": "CartPage", "assertion": "verify_product_in_cart"},
        {"page": "HeaderPage", "assertion": "verify_cart_count"},
        {"page": "CartPage", "assertion": "verify_cart_total"}
      ],
      "test_data": {
        "product_c": {"product_name": "Laptop Stand", "quantity": 2, "available_stock": 5},
        "update_quantity_attempt": {"product_name": "Laptop Stand", "quantity": 10},
        "expected_cart_count": 1,
        "expected_cart_total": "unchanged"
      }
    },
    "1492": {
