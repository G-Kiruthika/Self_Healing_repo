{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "TC-003": {
      "test_name": "test_add_subscription_product_d_to_cart",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "ShoppingCartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "user_login"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "user_login"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "locate_product", "data_ref": "vitamin_pack"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "vitamin_pack"},
        {"page": "ProductCatalogPage", "assertion": "is_product_visible"},
        {"page": "ShoppingCartPage", "assertion": "is_product_in_cart"},
        {"page": "ShoppingCartPage", "assertion": "is_subscription_indicator_displayed"},
        {"page": "ShoppingCartPage", "assertion": "verify_subtotal"}
      ],
      "test_data": {
        "user_login": {
          "username": "customer",
          "password": "<password>"
        },
        "vitamin_pack": {
          "product_name": "Vitamin Pack",
          "quantity": 2,
          "expected_subtotal": "$91.00"
        }
      }
    },
    "TC-004": {
      "test_name": "test_cart_with_multiple_products",
      "feature": "ShoppingCart",
      "target_file": "test_shopping_cart.py",
      "pages_used": [
        "ProductCatalogPage",
        "ShoppingCartPage"
      ],
      "flow": [
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_a"},
        {"page": "ProductCatalogPage", "action": "add_product_to_cart", "data_ref": "product_b"},
        {"page": "ShoppingCartPage", "action": "view_cart", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "is_product_in_cart"},
        {"page": "ShoppingCartPage", "assertion": "get_cart_item_details"},
        {"page": "ShoppingCartPage", "assertion": "verify_overall_total"}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "quantity": 1,
          "unit_price": "$25.00",
          "expected_subtotal": "$25.00"
        },
        "product_b": {
          "product_name": "Coffee Subscription",
          "quantity": 3,
          "unit_price": "$15.99",
          "expected_subtotal": "$47.97"
        },
        "overall": {
          "expected_total": "$72.97"
        }
      }
    }
  },
  "framework": {
    "architecture": "python-ui-api-automation-framework",
    "type": "ui",
    "base_classes_required": ["BasePage"],
    "core_dependencies": [
      "core/driver_factory.py",
      "core/selenium_wrapper.py"
    ],
    "api_dependencies": [],
    "config_dependencies": ["config/config.yaml"],
    "utils_dependencies": [],
    "external_libraries": ["selenium", "pytest", "pyyaml"],
    "required_imports": ["pages.", "core.driver_factory", "pages.base_page"]
  }
}
