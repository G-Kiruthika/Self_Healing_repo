        {"page": "CartPage", "action": "get_line_item_subtotal", "data_ref": "coffee_subscription_subtotal"},
        {"page": "CartPage", "assertion": "validate_product_present"},
        {"page": "CartPage", "assertion": "validate_quantity"},
        {"page": "CartPage", "assertion": "validate_warning_message"}
