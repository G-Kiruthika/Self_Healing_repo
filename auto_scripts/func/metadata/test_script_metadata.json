        {"page": "LoginPage", "action": "login", "data_ref": "user_john_doe_premium"},
        {"page": "LoginPage", "assertion": "is_premium_user"},
        {"page": "ProductCatalogPage", "action": "search_product", "data_ref": "organic_green_tea"},
