{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "TC_001": {
      "test_name": "test_add_product_a_to_cart",
      "feature": "ShoppingCart",
      "target_file": "test_add_product_a_to_cart.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user1"},
        {"page": "ProductCatalogPage", "action": "add_product_a_to_cart", "data_ref": null},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_icon_updated", "data_ref": 1},
        {"page": "CartPage", "assertion": "verify_product_a_subtotal", "data_ref": "$25.00"}
      ],
      "test_data": {
        "user1": {
          "username": "customer_user",
          "password": "customer_pass"
        },
        "product_a": {
          "name": "Wireless Mouse",
          "price": 25.00,
          "quantity": 1
        }
      }
    },
    "TC_002": {
      "test_name": "test_add_product_b_to_cart_with_threshold",
      "feature": "ShoppingCart",
      "target_file": "test_add_product_b_to_cart_with_threshold.py",
      "pages_used": ["LoginPage", "ProductCatalogPage", "CartPage"],
      "flow": [
        {"page": "LoginPage", "action": "login", "data_ref": "user1"},
        {"page": "ProductCatalogPage", "action": "add_product_b_to_cart", "data_ref": null},
        {"page": "CartPage", "action": "open_cart", "data_ref": null},
        {"page": "CartPage", "assertion": "is_cart_icon_updated", "data_ref": 3},
        {"page": "CartPage", "assertion": "verify_product_b_subtotal", "data_ref": "$47.97"}
      ],
      "test_data": {
        "user1": {
          "username": "customer_user",
          "password": "customer_pass"
        },
        "product_b": {
          "name": "Coffee Subscription",
          "price": 15.99,
          "quantity": 3,
          "min_threshold": 3
        }
      }
    }
  },
