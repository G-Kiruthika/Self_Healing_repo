      "flow": [
        {"page": "CartPage", "action": "validate_product_in_cart", "data_ref": "product_a"},
        {"page": "CartPage", "action": "delete_product", "data_ref": "product_a"},
        {"page": "CartPage", "assertion": "validate_product_not_in_cart", "data_ref": "product_a"},
        {"page": "CartPage", "assertion": "validate_empty_cart_message", "data_ref": null},
