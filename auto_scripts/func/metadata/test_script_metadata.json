{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1486": {
      "test_name": "test_cart_multiple_products",
      "feature": "Shopping Cart",
      "target_file": "test_cart_multiple_products.py",
      "pages_used": ["ProductListPage", "ShoppingCartPage"],
      "flow": [
        {"page": "ProductListPage", "action": "add_product", "data_ref": "product_a"},
        {"page": "ProductListPage", "action": "add_product", "data_ref": "product_b"},
        {"page": "ProductListPage", "action": "go_to_cart", "data_ref": null},
        {"page": "ShoppingCartPage", "assertion": "is_product_in_cart", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "assertion": "is_product_in_cart", "data_ref": "product_b"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_details", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_details", "data_ref": "product_b"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "cart_total"}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "unit_price": 25.00,
          "quantity": 1,
          "subtotal": 25.00
        },
        "product_b": {
          "product_name": "Coffee Subscription",
          "unit_price": 15.99,
          "quantity": 3,
          "subtotal": 47.97
        },
        "cart_total": {
          "expected_total": 72.97
        }
      }
    },
    "1487": {
      "test_name": "test_cart_update_quantity",
      "feature": "Shopping Cart",
      "target_file": "test_cart_update_quantity.py",
      "pages_used": ["ShoppingCartPage"],
      "flow": [
        {"page": "ShoppingCartPage", "assertion": "is_product_in_cart", "data_ref": "product_a"},
        {"page": "ShoppingCartPage", "action": "update_quantity", "data_ref": "update_quantity"},
        {"page": "ShoppingCartPage", "assertion": "verify_product_details", "data_ref": "product_a_updated"},
        {"page": "ShoppingCartPage", "assertion": "verify_cart_total", "data_ref": "cart_total"},
        {"page": "ShoppingCartPage", "assertion": "is_loading_spinner_visible", "data_ref": null}
      ],
      "test_data": {
        "product_a": {
          "product_name": "Wireless Mouse",
          "unit_price": 25.00,
          "quantity": 1,
          "subtotal": 25.00
        },
        "update_quantity": {
          "product_name": "Wireless Mouse",
          "quantity": 5
        },
        "product_a_updated": {
          "product_name": "Wireless Mouse",
          "unit_price": 25.00,
          "quantity": 5,
          "subtotal": 125.00
        },
        "cart_total": {
          "expected_total": 125.00
        }
      }
    }
  },
