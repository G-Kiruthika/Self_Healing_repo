{
  "test_suite": "Functional UI Suite",
  "test_cases": {
    "1485": {
      "test_name": "test_add_subscription_product_to_cart",
      "feature": "Product Subscription Cart",
      "target_file": "test_product_subscription_cart.py",
      "pages_used": [
        "LoginPage",
        "ProductCatalogPage",
        "CartPage"
      ],
      "flow": [
        {"page": "LoginPage", "action": "enter_username", "data_ref": "user_credentials"},
        {"page": "LoginPage", "action": "enter_password", "data_ref": "user_credentials"},
        {"page": "LoginPage", "action": "click_login", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "navigate_to_product_catalog", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "locate_product_d", "data_ref": null},
        {"page": "ProductCatalogPage", "action": "click_add_to_cart_for_product_d", "data_ref": null},
        {"page": "ProductCatalogPage", "assertion": "is_product_d_visible"},
        {"page": "CartPage", "assertion": "is_product_d_in_cart"},
        {"page": "CartPage", "assertion": "is_subscription_indicator_displayed_for_product_d"},
        {"page": "CartPage", "assertion": "is_subtotal_correct_for_product_d", "data_ref": "expected_subtotals"}
      ],
      "test_data": {
        "user_credentials": {
          "username": "customer1",
          "password": "password123"
        },
        "expected_subtotals": {
          "product_d_subtotal": "$91.00"
        }
      }
    },
    "1488": {
      "test_name": "test_update_subscription_quantity_and_verify_totals",
      "feature": "Product Subscription Cart",
      "target_file": "test_product_subscription_cart.py",
      "pages_used": [
        "CartPage"
      ],
      "flow": [
        {"page": "CartPage", "assertion": "is_product_d_in_cart"},
        {"page": "CartPage", "action": "increase_quantity_for_product_d", "data_ref": "quantity_update"},
        {"page": "CartPage", "assertion": "is_subtotal_correct_for_product_d", "data_ref": "expected_subtotals"},
        {"page": "CartPage", "assertion": "is_cart_total_correct", "data_ref": "expected_totals"}
      ],
      "test_data": {
        "quantity_update": {
          "quantity": 6
        },
        "expected_subtotals": {
          "product_d_subtotal": "$273.00"
        },
        "expected_totals": {
          "cart_total": "$273.00"
        }
      }
    }
  },
